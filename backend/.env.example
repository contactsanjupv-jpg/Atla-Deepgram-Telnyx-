# Copy to .env and fill in. Never commit the real .env.

# development | test | production  (anything else refuses to start)
ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://atla:atla@localhost:5432/atla
REDIS_URL=redis://localhost:6379/0

# Retell — server-side only. Never expose this to the frontend.
RETELL_API_KEY=
RETELL_API_BASE_URL=https://api.retellai.com

# Google Calendar OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Used by the website importer to turn crawled page text into structured
# business info (services, FAQs, hours). Get a key at console.anthropic.com.
# Not required for auth/tenant-isolation work — only for /businesses/import-website.
ANTHROPIC_API_KEY=

# Groq (free tier) — website importer LLM. Model must be available on your account.
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b

# Paddle billing (sandbox first) — server-side only.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_STARTER_PRICE_ID=
PADDLE_GROWTH_PRICE_ID=

# --- Public URL Retell can reach (use your ngrok/hosted HTTPS URL; NOT localhost) ---
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Receptionist runtime ---
RETELL_LLM_MODEL=
AGENT_MAX_CALL_SECONDS=900
FREE_TEST_CALLS_PER_ORG=5
TEST_CALL_MAX_SECONDS=180

# --- Billing-lapse policy (PLACEHOLDERS — business decisions) ---
PAST_DUE_GRACE_DAYS=3
NUMBER_RELEASE_DELAY_DAYS=7

# --- Outgoing email for password reset (any SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Atla <no-reply@yourdomain.com>

# Worker (defaults shown)
# WORKER_PASS_BUDGET_SECONDS=300
# WORKER_WATCHDOG_EXIT=true
# VOICE_SYNC_INTERVAL_SECONDS=21600
# BILLING_RECONCILE_INTERVAL_SECONDS=21600
# BILLING_RECONCILE_RETRY_SECONDS=900
