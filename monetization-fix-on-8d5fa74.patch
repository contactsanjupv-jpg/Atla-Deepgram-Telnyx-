@@ -0,0 +1,37 @@
+import type { PlanFeature, PlanOut } from "./api";
+
+export interface PlanHighlight {
+  plan: PlanOut;
+  /** Name of the plan this one builds on ("Everything in Starter, plus:"), or null for the first plan. */
+  inherits: string | null;
+  /** Features this plan has that the previous plan does not. For the first plan: all its features. */
+  added: PlanFeature[];
+  /** Extra monthly minutes compared with the previous plan (null for the first plan or if not larger). */
+  extraMinutes: number | null;
+  recommended: boolean;
+}
+
+/**
+ * Turns the backend catalog into "what each plan adds". The catalog is ordered cheapest first; a plan builds on
+ * the one before it. The recommended plan is the one that adds real features over the plan before it.
+ */
+export function planHighlights(plans: PlanOut[]): PlanHighlight[] {
+  const ordered = [...plans];
+  return ordered.map((plan, i) => {
+    const prev = i > 0 ? ordered[i - 1] : null;
+    const prevIds = new Set(prev?.features.map((f) => f.id) ?? []);
+    const added = plan.features.filter((f) => !prevIds.has(f.id));
+    const extra = prev && plan.included_minutes > prev.included_minutes ? plan.included_minutes - prev.included_minutes : null;
+    return {
+      plan,
+      inherits: prev ? prev.name : null,
+      added,
+      extraMinutes: extra,
+      recommended: prev !== null && (added.length > 0 || extra !== null) && i === ordered.length - 1,
+    };
+  });
+}
+
+export function minutesPerMonth(minutes: number): string {
+  return `${minutes.toLocaleString()} minutes of receptionist time every month`;
+}
diff --git a/frontend/src/lib/useCheckoutState.ts b/frontend/src/lib/useCheckoutState.ts
new file mode 100644
index 0000000..459766b
--- /dev/null
+++ b/frontend/src/lib/useCheckoutState.ts
@@ -0,0 +1,54 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { api, CheckoutState } from "./api";
+
+const POLL_MS = 3000;
+const MAX_POLLS = 40; // about two minutes of "payment is processing"
+
+/**
+ * What is happening with this organization's checkout, as the SERVER reads it from Paddle.
+ * While a payment is processing it re-checks every few seconds; `onSettled` fires when the server says the
+ * checkout is no longer in flight (the plan is active, or the checkout expired).
+ */
+export function useCheckoutState(orgId: string, enabled: boolean, onSettled?: () => void) {
+  const [state, setState] = useState<CheckoutState | null>(null);
+  const [failed, setFailed] = useState(false);
+  const polls = useRef(0);
+  const settled = useRef(onSettled);
+  useEffect(() => {
+    settled.current = onSettled;
+  });
+
+  const refresh = useCallback(async () => {
+    try {
+      const next = await api.getCheckoutState(orgId);
+      setState(next);
+      setFailed(false);
+      return next;
+    } catch {
+      setFailed(true);
+      return null;
+    }
+  }, [orgId]);
+
+  useEffect(() => {
+    if (!enabled) return;
+    let live = true;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    polls.current = 0;
+    const tick = async () => {
+      const next = await refresh();
+      if (!live || !next) return;
+      if (next.state === "processing" && polls.current++ < MAX_POLLS) timer = setTimeout(tick, POLL_MS);
+      else if (next.state === "none" || next.state === "expired") settled.current?.();
+    };
+    void tick();
+    return () => {
+      live = false;
+      if (timer) clearTimeout(timer);
+    };
+  }, [enabled, refresh]);
+
+  return { state, failed, refresh };
+}
diff --git a/frontend/src/lib/useFeatures.ts b/frontend/src/lib/useFeatures.ts
new file mode 100644
index 0000000..ce3661a
--- /dev/null
+++ b/frontend/src/lib/useFeatures.ts
@@ -0,0 +1,23 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { api } from "./api";
+
+/** Which paid features the server says this organization has right now. `null` while loading or unreadable. */
+export function useFeatures(orgId: string | undefined): { features: Set<string> | null; plan: string | null } {
+  const [data, setData] = useState<{ features: Set<string>; plan: string | null } | null>(null);
+  useEffect(() => {
+    if (!orgId) return;
+    let live = true;
+    api
+      .getSubscription(orgId)
+      .then((sub) => {
+        if (live) setData({ features: new Set(sub?.entitled ? sub.features.map((f) => f.id) : []), plan: sub?.plan_name ?? null });
+      })
+      .catch(() => undefined);
+    return () => {
+      live = false;
+    };
+  }, [orgId]);
+  return { features: data?.features ?? null, plan: data?.plan ?? null };
+}
