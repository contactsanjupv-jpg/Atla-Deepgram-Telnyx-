+    cb = _adjustment(txn, action="chargeback")
+    assert _adjust(cb) is True and _balance(org) == 0
+    assert _adjust(cb) is False
+    assert _adjust(_adjustment(txn, action="chargeback_reverse")) is True
+    assert _balance(org) == seconds
