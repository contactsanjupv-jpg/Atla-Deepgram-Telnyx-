diff --git a/backend/app/services/checkout_guard.py b/backend/app/services/checkout_guard.py
new file mode 100644
index 0000000..8624301
--- /dev/null
+++ b/backend/app/services/checkout_guard.py
@@ -0,0 +1,44 @@
+"""
+One open checkout per organization.
+
+Why: a Paddle transaction exists (and can be paid) from the moment we create it.
+If a customer opens checkout twice and pays both, Paddle creates two subscriptions
+and charges twice. So while a checkout is pending we hand back the SAME checkout
+URL for the same plan, and refuse to open a second one for a different plan.
+The marker clears when the subscription webhook arrives, when services/checkout_recovery.py
+sees Paddle say the transaction is dead, or after the TTL. It stores the Paddle transaction id so
+the real state can be read back instead of guessing.
+(services/duplicate_subscriptions.py is the second line of defence.)
+"""
+import json
+
+import redis
+
+from app.config import get_settings
+
+_redis = redis.from_url(get_settings().REDIS_URL, decode_responses=True)
+# Long on purpose: the marker is cleared only when Paddle confirms the transaction is dead (or a subscription
+# exists), so a payable checkout is never forgotten. The TTL is just garbage collection for abandoned orgs.
+PENDING_TTL_SECONDS = 86400
+
+
+def _key(organization_id) -> str:
+    return f"pending-checkout:{organization_id}"
+
+
+def get_pending(organization_id) -> dict | None:
+    raw = _redis.get(_key(organization_id))
+    return json.loads(raw) if raw else None
+
+
+def set_pending(organization_id, plan_id: str, checkout_url: str, transaction_id: str | None = None) -> None:
+    payload = {"plan": plan_id, "checkout_url": checkout_url, "transaction_id": transaction_id}
+    _redis.set(_key(organization_id), json.dumps(payload), ex=PENDING_TTL_SECONDS)
+
+
+def pending_ttl_seconds(organization_id) -> int:
+    return max(0, int(_redis.ttl(_key(organization_id))))
+
+
+def clear_pending(organization_id) -> None:
+    _redis.delete(_key(organization_id))
diff --git a/backend/app/services/checkout_recovery.py b/backend/app/services/checkout_recovery.py
new file mode 100644
index 0000000..699159b
--- /dev/null
+++ b/backend/app/services/checkout_recovery.py
@@ -0,0 +1,137 @@
+"""
+What is really going on with this organization's open checkout — read from Paddle, never guessed.
+
+A pending-checkout marker (services/checkout_guard.py) means "we created a Paddle transaction and the
+customer may still pay it". This service turns that into one of five honest states and the one safe
+next step for each:
+
+  none         no checkout in flight
+  open         the transaction can still be paid -> RESUME the same link (never a second transaction)
+  processing   Paddle took the money (completed/paid) but our subscription row isn't there yet -> wait;
+               we pull the subscription from Paddle right now through the same stale-safe path the webhook uses
+  expired      Paddle says canceled / past_due: nothing was paid -> marker cleared, a new checkout is safe
+  unconfirmed  Paddle couldn't be reached -> change nothing, do not allow a conflicting checkout
+
+The marker is cleared only for `expired` or once an active subscription exists. A different plan may be
+chosen only when the old transaction is provably dead (expired) or Paddle confirms it canceled it
+(Paddle allows canceling draft, ready and billed transactions through its API).
+Everything is idempotent and safe to call from many tabs at once.
+"""
+import logging
+import uuid
+from dataclasses import dataclass
+from datetime import datetime, timezone
+
+from sqlalchemy.orm import Session
+
+from app.db.models.billing import Subscription
+from app.services.billing_state import ACTIVE_STATUSES, has_active_subscription
+from app.services.checkout_guard import clear_pending, get_pending, pending_ttl_seconds
+from app.services.subscription_sync import parse_dt, sync_subscription
+
+logger = logging.getLogger("atla.checkout_recovery")
+
+OPEN_STATUSES = ("draft", "ready", "billed")
+PAID_STATUSES = ("paid", "completed")
+DEAD_STATUSES = ("canceled", "past_due")
+
+
+@dataclass
+class CheckoutState:
+    state: str  # none | open | processing | expired | unconfirmed
+    plan: str | None = None
+    checkout_url: str | None = None
+    message: str = ""
+    expires_in_seconds: int | None = None
+
+
+def _provider(provider):
+    if provider is not None:
+        return provider
+    from app.providers.billing.paddle_billing_provider import PaddleBillingProvider
+
+    return PaddleBillingProvider()
+
+
+def _pull_subscription(db: Session, provider, txn: dict) -> bool:
+    """The transaction is paid: fetch its subscription from Paddle and apply it (stale-safe). True once an active row exists."""
+    sub_id = txn.get("subscription_id")
+    if not sub_id:
+        return False
+    snapshot = provider.get_subscription(sub_id)
+    if snapshot is not None:
+        at = parse_dt(snapshot.get("updated_at")) or datetime.now(timezone.utc)
+        sync_subscription(db, snapshot, at)
+        db.commit()
+    row = db.query(Subscription).filter(Subscription.external_subscription_id == sub_id).first()
+    return row is not None and row.status in ACTIVE_STATUSES
+
+
+def resolve_checkout(db: Session, organization_id: uuid.UUID, provider=None) -> CheckoutState:
+    if has_active_subscription(db, organization_id):
+        clear_pending(organization_id)
+        return CheckoutState("none", message="Your plan is active.")
+    pending = get_pending(organization_id)
+    if pending is None:
+        return CheckoutState("none")
+
+    plan, url, txn_id = pending.get("plan"), pending.get("checkout_url"), pending.get("transaction_id")
+    ttl = pending_ttl_seconds(organization_id)
+    if not txn_id:  # created before transaction ids were recorded: we can only trust the 15-minute window
+        return CheckoutState("open", plan, url, "You have a checkout in progress. Finish it to start your plan.", ttl)
+
+    try:
+        provider = _provider(provider)
+        txn = provider.get_transaction(txn_id)
+    except RuntimeError:
+        return CheckoutState(
+            "unconfirmed", plan, None,
+            "We can't confirm your payment status right now. Please wait a minute and refresh. Don't pay again.", ttl,
+        )
+    if txn is None:
+        clear_pending(organization_id)
+        return CheckoutState("expired", plan, None, "That checkout is no longer available. You can start a new one.")
+
+    status = txn.get("status")
+    if status in DEAD_STATUSES:
+        clear_pending(organization_id)
+        return CheckoutState("expired", plan, None, "Your last checkout expired without a payment. You can start a new one.")
+    if status in PAID_STATUSES:
+        try:
+            ready = _pull_subscription(db, provider, txn)
+        except RuntimeError:
+            ready = False
+        if ready:
+            clear_pending(organization_id)
+            return CheckoutState("none", plan, None, "Your plan is active.")
+        return CheckoutState(
+            "processing", plan, None,
+            "Your payment went through. We're finishing your setup — this usually takes a few seconds. Please don't pay again.",
+        )
+    # draft / ready / billed (or any status we don't recognise): still payable. Never assume it is dead.
+    return CheckoutState("open", plan, url, "You have a checkout in progress. Finish it to start your plan.", ttl)
+
+
+def release_for_new_plan(db: Session, organization_id: uuid.UUID, wanted_plan: str, provider=None) -> CheckoutState:
+    """
+    The customer asked for `wanted_plan` while a checkout for another plan is pending. Returns a state whose
+    `.state` is "none"/"expired" when a new checkout is now safe; anything else means it is NOT safe yet.
+    Paddle must confirm the old transaction is canceled before we let a second one exist.
+    """
+    current = resolve_checkout(db, organization_id, provider)
+    if current.state != "open" or current.plan == wanted_plan:
+        return current
+    pending = get_pending(organization_id) or {}
+    txn_id = pending.get("transaction_id")
+    if txn_id:
+        try:
+            if _provider(provider).cancel_transaction(txn_id):
+                clear_pending(organization_id)
+                return CheckoutState("expired", current.plan, None, "Your previous checkout was canceled.")
+        except RuntimeError:
+            pass
+    current.message = (
+        f"You already have a {str(current.plan).title()} checkout open. Finish it to start your plan, "
+        "or try again in a moment to switch to a different plan."
+    )
+    return current
diff --git a/backend/app/services/credits.py b/backend/app/services/credits.py
new file mode 100644
index 0000000..beaebba
--- /dev/null
+++ b/backend/app/services/credits.py
@@ -0,0 +1,302 @@
+"""
+Credits: what a customer has been given, what they have used, what is left.
+
+ONE source of truth, two append-only tables, no counters:
+  * credit_ledger  — plan grants, top-ups, refunds / chargebacks, manual adjustments
+  * usage_ledger   — one row per call (unique on the provider call id), with its duration
+
+A balance is a pure function of those rows (`credit_summary`). Because nothing is stored as a
+running total, a duplicate or late webhook can never double-charge or double-grant: grants and
+top-ups are unique by idempotency key, calls are unique by call id, and a late event simply changes
+the inputs the next read is computed from.
+
+Unit: seconds in the database, minutes on screen. A call is charged for exactly the seconds it ran.
+
+Rules (the customer-facing policy, enforced here):
+  * Monthly included minutes are granted once per billing period, expire when the period ends and
+    never roll over. Calls are charged to the included allowance of the period they happened in.
+  * Anything beyond the allowance is charged to the purchased balance. Purchased credits never
+    expire. The purchased balance may go NEGATIVE (a call cannot be refused mid-flight, and a refund
+    can claw back credits already spent); the next top-up repays that first.
+  * Chargeable usage = production calls + test calls made while subscribed. The one promised free
+    test call ("free_test") is recorded with its real provider cost but is never charged.
+  * Usage from before an organization's first grant is never charged (it pre-dates billing).
+"""
+import logging
+import uuid
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta, timezone
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from sqlalchemy import func, text
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Session
+
+from app.config import get_settings
+from app.db.models.billing import CreditLedgerEntry, Subscription, UsageLedgerEntry
+from app.db.models.calls import Call, CallDirection
+from app.services.billing_state import ACTIVE_STATUSES, current_subscription
+from app.services.plans import PLANS
+
+logger = logging.getLogger("atla.credits")
+
+CHARGEABLE_KINDS = ("production", "test")
+INCLUDED, PURCHASED = "included", "purchased"
+
+
+@dataclass(frozen=True)
+class CreditSummary:
+    entitled: bool  # has a trialing/active plan right now
+    period_start: datetime | None
+    period_end: datetime | None
+    included_granted_seconds: int
+    included_used_seconds: int
+    included_remaining_seconds: int
+    purchased_balance_seconds: int  # may be negative
+    available_seconds: int  # included remaining + purchased balance (may be negative)
+    status: str  # "ok" | "low" | "empty"
+
+
+def _now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def lock_org_credits(db: Session, organization_id: uuid.UUID) -> None:
+    """Serialises credit decisions for one org for the rest of the transaction (released at commit/rollback)."""
+    db.execute(text("SELECT pg_advisory_xact_lock(hashtextextended(:k, 0))"), {"k": f"credits:{organization_id}"})
+
+
+# ---------------------------------------------------------------- grants
+
+def _insert_once(db: Session, entry: CreditLedgerEntry) -> bool:
+    """Insert unless this idempotency key already exists. True if inserted."""
+    try:
+        with db.begin_nested():
+            db.add(entry)
+            db.flush()
+        return True
+    except IntegrityError:
+        return False
+
+
+def ensure_plan_grant(db: Session, sub: Subscription, now: datetime | None = None) -> bool:
+    """
+    Grants the plan's included minutes for the subscription's CURRENT billing period, exactly once
+    (idempotency key = subscription + period start). Safe to call from the webhook, the reconciler, or
+    anywhere else, any number of times and in any order. Returns True only if it created the grant.
+    """
+    now = now or _now()
+    if sub.status not in ACTIVE_STATUSES or not sub.current_period_start or not sub.current_period_end:
+        return False
+    if sub.current_period_end <= now:
+        return False  # a stale snapshot of a period that is already over grants nothing
+    plan = PLANS.get(sub.plan_id)
+    if plan is None or plan.included_minutes <= 0:
+        return False
+    key = f"grant:{sub.external_subscription_id or sub.id}:{sub.current_period_start.isoformat()}"
+    created = _insert_once(
+        db,
+        CreditLedgerEntry(
+            organization_id=sub.organization_id,
+            kind="plan_grant",
+            bucket=INCLUDED,
+            seconds=plan.included_minutes * 60,
+            period_start=sub.current_period_start,
+            period_end=sub.current_period_end,
+            reference=sub.external_subscription_id,
+            idempotency_key=key,
+            note=f"{plan.name} monthly included minutes",
+        ),
+    )
+    if created:
+        logger.info("Granted %s min [org=%s plan=%s period=%s]", plan.included_minutes, sub.organization_id, plan.id, sub.current_period_start)
+    return created
+
+
+def ensure_current_grant(db: Session, organization_id: uuid.UUID) -> bool:
+    sub = current_subscription(db, organization_id)
+    return ensure_plan_grant(db, sub) if sub is not None else False
+
+
+def add_ledger_entry(
+    db: Session,
+    *,
+    organization_id: uuid.UUID,
+    kind: str,
+    seconds: int,
+    idempotency_key: str,
+    reference: str | None = None,
+    note: str | None = None,
+    bucket: str = PURCHASED,
+) -> bool:
+    """Top-ups, refunds, chargebacks, manual adjustments. Idempotent by key."""
+    return _insert_once(
+        db,
+        CreditLedgerEntry(
+            organization_id=organization_id,
+            kind=kind,
+            bucket=bucket,
+            seconds=seconds,
+            reference=reference,
+            idempotency_key=idempotency_key,
+            note=note,
+        ),
+    )
+
+
+# ---------------------------------------------------------------- balance
+
+def _chargeable_seconds(db: Session, organization_id: uuid.UUID, start=None, end=None) -> int:
+    q = db.query(func.coalesce(func.sum(UsageLedgerEntry.billable_seconds), 0)).filter(
+        UsageLedgerEntry.organization_id == organization_id, UsageLedgerEntry.kind.in_(CHARGEABLE_KINDS)
+    )
+    if start is not None:
+        q = q.filter(UsageLedgerEntry.occurred_at >= start)
+    if end is not None:
+        q = q.filter(UsageLedgerEntry.occurred_at < end)
+    return int(q.scalar())
+
+
+def credit_summary(db: Session, organization_id: uuid.UUID, now: datetime | None = None) -> CreditSummary:
+    now = now or _now()
+    settings = get_settings()
+    grants = (
+        db.query(CreditLedgerEntry)
+        .filter(CreditLedgerEntry.organization_id == organization_id, CreditLedgerEntry.kind == "plan_grant")
+        .order_by(CreditLedgerEntry.period_start.asc(), CreditLedgerEntry.created_at.asc())
+        .all()
+    )
+
+    attributed = 0
+    overage = 0
+    current = None  # (grant, used, effective_end)
+    for i, g in enumerate(grants):
+        effective_end = g.period_end
+        if i + 1 < len(grants) and grants[i + 1].period_start < effective_end:
+            effective_end = grants[i + 1].period_start  # overlapping grants: the newer one owns the overlap
+        used = _chargeable_seconds(db, organization_id, g.period_start, effective_end)
+        attributed += used
+        overage += max(0, used - g.seconds)
+        if g.period_start <= now < effective_end:
+            current = (g, used, effective_end)
+
+    unattributed = 0
+    if grants:
+        after_first = _chargeable_seconds(db, organization_id, start=grants[0].period_start)
+        unattributed = max(0, after_first - attributed)  # after billing began, outside any paid period
+
+    purchased_rows = int(
+        db.query(func.coalesce(func.sum(CreditLedgerEntry.seconds), 0))
+        .filter(CreditLedgerEntry.organization_id == organization_id, CreditLedgerEntry.bucket == PURCHASED)
+        .scalar()
+    )
+    purchased_balance = purchased_rows - overage - unattributed
+
+    if current is not None:
+        g, used, _end = current
+        granted, included_used = g.seconds, min(used, g.seconds)
+        remaining = max(0, g.seconds - used)
+        period_start, period_end = g.period_start, g.period_end
+    else:
+        granted = included_used = remaining = 0
+        period_start = period_end = None
+
+    available = remaining + purchased_balance
+    entitled = current_subscription(db, organization_id) is not None and _is_entitled(db, organization_id)
+
+    if available <= 0:
+        status = "empty"
+    else:
+        floor = max(granted * settings.LOW_CREDIT_PERCENT // 100, 10 * 60) if granted else 10 * 60
+        status = "low" if available < floor else "ok"
+
+    return CreditSummary(
+        entitled=entitled,
+        period_start=period_start,
+        period_end=period_end,
+        included_granted_seconds=granted,
+        included_used_seconds=included_used,
+        included_remaining_seconds=remaining,
+        purchased_balance_seconds=purchased_balance,
+        available_seconds=available,
+        status=status,
+    )
+
+
+def _is_entitled(db: Session, organization_id: uuid.UUID) -> bool:
+    sub = current_subscription(db, organization_id)
+    return sub is not None and sub.status in ACTIVE_STATUSES
+
+
+def credits_exhausted_beyond_grace(db: Session, organization_id: uuid.UUID, now: datetime | None = None) -> bool:
+    """True once an entitled org has run further below zero than the configured grace allows."""
+    s = credit_summary(db, organization_id, now)
+    return s.entitled and s.available_seconds < -get_settings().OVERAGE_GRACE_MINUTES * 60
+
+
+# ---------------------------------------------------------------- test-call admission
+
+def open_test_reservations(db: Session, organization_id: uuid.UUID, now: datetime | None = None) -> int:
+    """Test calls started but not yet finished: each may still consume up to TEST_CALL_MAX_SECONDS."""
+    now = now or _now()
+    window = timedelta(seconds=get_settings().TEST_CALL_MAX_SECONDS + 120)
+    return (
+        db.query(func.count(Call.id))
+        .filter(
+            Call.organization_id == organization_id,
+            Call.direction == CallDirection.test,
+            Call.status.in_(("registered", "ongoing")),
+            Call.created_at >= now - window,
+        )
+        .scalar()
+    )
+
+
+def can_cover_paid_test(db: Session, organization_id: uuid.UUID, now: datetime | None = None) -> bool:
+    """Call inside the org's credit lock. Counts calls already in flight, so two simultaneous
+    requests cannot both spend the same last minutes."""
+    summary = credit_summary(db, organization_id, now)
+    needed = get_settings().TEST_CALL_MAX_SECONDS
+    in_flight = open_test_reservations(db, organization_id, now) * needed
+    return summary.available_seconds - in_flight >= needed
+
+
+# ---------------------------------------------------------------- reporting
+
+def resolve_timezone(name: str | None) -> ZoneInfo:
+    try:
+        return ZoneInfo(name) if name else ZoneInfo("UTC")
+    except (ZoneInfoNotFoundError, ValueError, KeyError):
+        return ZoneInfo("UTC")
+
+
+def daily_usage(db: Session, organization_id: uuid.UUID, days: int, tz_name: str | None, now: datetime | None = None) -> list[dict]:
+    """
+    One entry per calendar day in the caller's timezone, oldest first, for the last `days` days
+    (today included). A day with no calls is a real zero. calls = production calls handled;
+    credit_seconds = chargeable seconds (production + paid tests).
+    """
+    tz = resolve_timezone(tz_name)
+    now = now or _now()
+    today = now.astimezone(tz).date()
+    first = today - timedelta(days=days - 1)
+    start_utc = datetime.combine(first, datetime.min.time(), tzinfo=tz).astimezone(timezone.utc)
+
+    day = func.date(func.timezone(tz.key, UsageLedgerEntry.occurred_at)).label("day")
+    rows = (
+        db.query(
+            day,
+            func.count().filter(UsageLedgerEntry.kind == "production"),
+            func.coalesce(func.sum(UsageLedgerEntry.billable_seconds).filter(UsageLedgerEntry.kind.in_(CHARGEABLE_KINDS)), 0),
+        )
+        .filter(UsageLedgerEntry.organization_id == organization_id, UsageLedgerEntry.occurred_at >= start_utc)
+        .group_by(day)
+        .all()
+    )
+    by_day: dict[date, tuple[int, int]] = {r[0]: (int(r[1]), int(r[2])) for r in rows}
+    out = []
+    for i in range(days):
+        d = first + timedelta(days=i)
+        calls, secs = by_day.get(d, (0, 0))
+        out.append({"date": d.isoformat(), "calls": calls, "credit_seconds": secs})
+    return out
diff --git a/backend/app/services/duplicate_subscriptions.py b/backend/app/services/duplicate_subscriptions.py
new file mode 100644
index 0000000..191ea06
--- /dev/null
+++ b/backend/app/services/duplicate_subscriptions.py
@@ -0,0 +1,90 @@
+"""
+Second line of defence against paying twice (the first is services/checkout_guard).
+
+If an org somehow holds more than one trialing/active Paddle subscription, the
+OLDEST one is the subscription of record (billing_state.current_subscription uses
+the same rule). Every other one is scheduled to cancel at the END of its paid
+period: the customer is not charged again, nobody loses access mid-period, and
+nothing is refunded or deleted automatically — the first charge of the duplicate
+may need a manual refund, which is logged at ERROR level for a human.
+
+Safe to run repeatedly and from concurrent workers: a Redis marker per
+subscription means each cancel is requested once; a failed request clears the
+marker so it is retried by the next webhook or reconciliation run.
+"""
+import logging
+import uuid
+
+import redis
+from sqlalchemy.orm import Session
+
+from app.config import get_settings
+from app.db.models.billing import Subscription
+from app.providers.billing.paddle_billing_provider import PaddleBillingProvider
+from app.services.billing_state import ACTIVE_STATUSES
+from app.services.checkout_guard import clear_pending
+
+logger = logging.getLogger("atla.duplicate_subscriptions")
+_redis = redis.from_url(get_settings().REDIS_URL, decode_responses=True)
+_MARKER_TTL_SECONDS = 86400
+
+
+def duplicate_subscriptions(db: Session, organization_id: uuid.UUID) -> list[Subscription]:
+    rows = (
+        db.query(Subscription)
+        .filter(
+            Subscription.organization_id == organization_id,
+            Subscription.billing_provider == "paddle",
+            Subscription.status.in_(ACTIVE_STATUSES),
+        )
+        .order_by(Subscription.created_at.asc(), Subscription.id.asc())
+        .all()
+    )
+    return rows[1:]
+
+
+def schedule_duplicate_cancellations(db: Session, organization_id: uuid.UUID, provider_factory=None) -> list[str]:
+    """Returns the Paddle subscription ids a cancellation was requested for just now."""
+    duplicates = [
+        s for s in duplicate_subscriptions(db, organization_id) if s.external_subscription_id and s.cancel_effective_at is None
+    ]
+    if not duplicates:
+        return []
+    provider = (provider_factory or PaddleBillingProvider)()
+    requested: list[str] = []
+    for sub in duplicates:
+        marker = f"dup-cancel:{sub.external_subscription_id}"
+        if not _redis.set(marker, "1", nx=True, ex=_MARKER_TTL_SECONDS):
+            continue  # already requested (or being requested by another worker)
+        try:
+            provider.cancel_subscription(sub.external_subscription_id, immediately=False)
+        except Exception as e:  # noqa: BLE001 — retried on the next webhook / reconcile run
+            _redis.delete(marker)
+            logger.error("Could not schedule cancel of duplicate subscription [org=%s sub=%s]: %s", organization_id, sub.external_subscription_id, e)
+            continue
+        requested.append(sub.external_subscription_id)
+        logger.error(
+            "DUPLICATE SUBSCRIPTION: scheduled cancel at period end; customer may have been charged twice — "
+            "review a refund [org=%s duplicate=%s]",
+            organization_id,
+            sub.external_subscription_id,
+        )
+    return requested
+
+
+def after_subscription_applied(db: Session, data: dict) -> None:
+    """Run AFTER the webhook transaction committed. Never raises: a billing-side-effect
+    problem must not turn a correctly stored event into a webhook failure."""
+    try:
+        external_id = data.get("id")
+        sub = (
+            db.query(Subscription)
+            .filter(Subscription.billing_provider == "paddle", Subscription.external_subscription_id == external_id)
+            .first()
+        )
+        if sub is None or sub.status not in ACTIVE_STATUSES:
+            return
+        clear_pending(sub.organization_id)
+        schedule_duplicate_cancellations(db, sub.organization_id)
+    except Exception:  # noqa: BLE001
+        logger.exception("Post-webhook duplicate-subscription check failed")
