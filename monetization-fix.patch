+import type { SubscriptionOut } from "./api";
+import { formatDate } from "./billing";
+
+export type Tone = "ok" | "warn" | "bad" | "neutral";
+
+export interface StatusInfo {
+  label: string;
+  tone: Tone;
+  headline: string;
+  detail: string;
+}
+
+/** Translate the server's billing state into plain language. Entitlement itself comes from the server (`entitled`). */
+export function describeSubscription(sub: SubscriptionOut | null): StatusInfo {
+  if (sub === null) {
+    return {
+      label: "No plan",
+      tone: "neutral",
+      headline: "You don't have a plan yet",
+      detail: "Choose a plan to get a phone number and put your receptionist on real calls.",
+    };
+  }
+  const end = formatDate(sub.current_period_end);
+  const cancelOn = formatDate(sub.cancel_effective_at);
+
+  if (sub.entitled && cancelOn) {
+    return {
+      label: "Ending",
+      tone: "warn",
+      headline: `Your plan ends on ${cancelOn}`,
+      detail: "Your receptionist keeps answering calls until then. You won't be charged again.",
+    };
+  }
+  if (sub.entitled && sub.status === "trialing") {
+    return {
+      label: "Trial",
+      tone: "ok",
+      headline: "Your trial is active",
+      detail: end ? `Your trial runs until ${end}.` : "Your receptionist is live.",
+    };
+  }
+  if (sub.entitled) {
+    return {
+      label: "Active",
+      tone: "ok",
+      headline: "Your plan is active",
+      detail: end ? `Your plan renews on ${end}.` : "Your receptionist is live.",
+    };
+  }
+  if (sub.status === "past_due") {
+    const stops = sub.service_ends_at ? new Date(sub.service_ends_at) : null;
+    const stillLive = stops !== null && stops.getTime() > Date.now();
+    return {
+      label: "Payment needed",
+      tone: "bad",
+      headline: "Your payment needs attention",
+      detail: stillLive
+        ? `Update your payment method to keep your receptionist active. It stays live until ${formatDate(sub.service_ends_at)}.`
+        : "Your receptionist has stopped answering calls. Update your payment method to bring it back.",
+    };
+  }
+  if (sub.status === "paused") {
+    return {
+      label: "Paused",
+      tone: "bad",
+      headline: "Your subscription is paused",
+      detail: "Your receptionist isn't answering calls while your subscription is paused.",
+    };
+  }
+  if (sub.status === "canceled") {
+    return {
+      label: "Ended",
+      tone: "neutral",
+      headline: "Your subscription has ended",
+      detail: "Your receptionist is no longer answering calls. Choose a plan to start again.",
+    };
+  }
+  if ((sub.status === "active" || sub.status === "trialing") && sub.plan_name === null) {
+    return {
+      label: "Needs review",
+      tone: "warn",
+      headline: "We couldn't confirm your plan details",
+      detail: "Your payment is active, but we can't match it to a plan right now. Please try again shortly.",
+    };
+  }
+  return { label: "Inactive", tone: "neutral", headline: "Your plan isn't active", detail: "Choose a plan to start again." };
+}
diff --git a/frontend/src/lib/credits.ts b/frontend/src/lib/credits.ts
new file mode 100644
index 0000000..03377fd
--- /dev/null
+++ b/frontend/src/lib/credits.ts
@@ -0,0 +1,110 @@
+import type { CreditsOut, DailyPoint } from "./api";
+
+/** Customer-facing credit unit: minutes of receptionist time. The database stores seconds. */
+export function minutesLabel(seconds: number): string {
+  const minutes = Math.floor(Math.abs(seconds) / 60);
+  return `${minutes.toLocaleString()} min`;
+}
+
+export function formatDollars(amountMinor: number, currency = "USD"): string {
+  const whole = amountMinor % 100 === 0;
+  return new Intl.NumberFormat(undefined, {
+    style: "currency",
+    currency,
+    minimumFractionDigits: whole ? 0 : 2,
+    maximumFractionDigits: 2,
+  }).format(amountMinor / 100);
+}
+
+export type CreditView =
+  | { kind: "unmetered" } // no plan / no grant yet: there is no balance to show
+  | { kind: "metered"; tone: "ok" | "low" | "empty"; remaining: string; used: string; granted: string; usedPercent: number; owes: string | null; purchased: string };
+
+/** What the dashboard says about the balance. Straight from the server's numbers; nothing is estimated. */
+export function creditView(c: CreditsOut): CreditView {
+  if (!c.entitled && c.included_granted_seconds === 0 && c.purchased_balance_seconds === 0) return { kind: "unmetered" };
+  const granted = c.included_granted_seconds;
+  const usedPercent = granted > 0 ? Math.min(100, Math.round((c.included_used_seconds / granted) * 100)) : 0;
+  return {
+    kind: "metered",
+    tone: c.status,
+    remaining: minutesLabel(Math.max(0, c.available_seconds)),
+    used: minutesLabel(c.included_used_seconds),
+    granted: minutesLabel(granted),
+    usedPercent,
+    owes: c.purchased_balance_seconds < 0 ? minutesLabel(c.purchased_balance_seconds) : null,
+    purchased: minutesLabel(Math.max(0, c.purchased_balance_seconds)),
+  };
+}
+
+export function creditBanner(c: CreditsOut): { tone: "low" | "empty"; title: string; body: string } | null {
+  if (!c.entitled) return null;
+  if (c.status === "empty") {
+    return {
+      tone: "empty",
+      title: "You're out of credits",
+      body: "Your receptionist keeps answering for a short grace period, then pauses until you add credits.",
+    };
+  }
+  if (c.status === "low") {
+    return { tone: "low", title: "You're running low on credits", body: `About ${minutesLabel(c.available_seconds)} left. Add credits so calls are never missed.` };
+  }
+  return null;
+}
+
+export type TopupCheck = { ok: true; amountMinor: number } | { ok: false; message: string };
+
+/** Client-side convenience only — the server re-validates every amount. Accepts "20", "20.5", "$1,250.00". */
+export function validateTopup(input: string, minMinor: number, maxMinor: number): TopupCheck {
+  const cleaned = input.replace(/[$,\s]/g, "");
+  if (cleaned === "") return { ok: false, message: "Enter an amount." };
+  if (!/^\d+(\.\d{1,2})?$/.test(cleaned)) return { ok: false, message: "Enter a dollar amount, like 25 or 25.50." };
+  const minor = Math.round(Number(cleaned) * 100);
+  if (minor < minMinor) return { ok: false, message: `The minimum top-up is ${formatDollars(minMinor)}.` };
+  if (minor > maxMinor) return { ok: false, message: `The maximum top-up is ${formatDollars(maxMinor)}.` };
+  return { ok: true, amountMinor: minor };
+}
+
+/** Quick-pick amounts derived from the server's minimum (never hardcoded). */
+export function quickAmounts(minMinor: number, maxMinor: number): number[] {
+  return [1, 2, 5].map((m) => minMinor * m).filter((a) => a <= maxMinor);
+}
+
+export interface ChartBar {
+  label: string; // YYYY-MM-DD
+  value: number;
+  height: number; // 0..1 of the plot height
+}
+
+/** Bars scaled to the real maximum. All-zero data returns bars of height 0 (the caller shows the empty state). */
+export function chartBars(points: DailyPoint[], pick: (p: DailyPoint) => number): { bars: ChartBar[]; max: number; empty: boolean } {
+  const values = points.map(pick);
+  const max = Math.max(0, ...values);
+  return {
+    bars: points.map((p, i) => ({ label: p.date, value: values[i], height: max > 0 ? values[i] / max : 0 })),
+    max,
+    empty: max === 0,
+  };
+}
+
+export function dayLabel(date: string): string {
+  const [y, m, d] = date.split("-").map(Number);
+  if (!y || !m || !d) return date;
+  return new Date(y, m - 1, d).toLocaleDateString(undefined, { month: "short", day: "numeric" });
+}
+
+export const EVENT_LABEL: Record<string, string> = {
+  plan_grant: "Monthly minutes added",
+  topup: "Credits purchased",
+  refund: "Refund",
+  chargeback: "Chargeback",
+  adjustment: "Adjustment",
+};
+
+export function browserTimeZone(): string {
+  try {
+    return Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC";
+  } catch {
+    return "UTC";
+  }
+}
diff --git a/frontend/src/lib/paddle.ts b/frontend/src/lib/paddle.ts
new file mode 100644
index 0000000..96b0edb
--- /dev/null
+++ b/frontend/src/lib/paddle.ts
@@ -0,0 +1,41 @@
+import { CheckoutEventNames, initializePaddle, type Paddle } from "@paddle/paddle-js";
+
+const TOKEN = process.env.NEXT_PUBLIC_PADDLE_CLIENT_TOKEN;
+const ENV = process.env.NEXT_PUBLIC_PADDLE_ENV === "live" ? "production" : "sandbox";
+
+interface Handlers {
+  onCompleted: () => void;
+  onClosed: () => void;
+}
+
+let paddle: Promise<Paddle | undefined> | null = null;
+let current: Handlers | null = null;
+
+export const paymentsConfigured = Boolean(TOKEN);
+
+/** "…/checkout?_ptxn=txn_01h…" -> "txn_01h…". The browser only ever opens a transaction OUR server created. */
+export function transactionIdFrom(checkoutUrl: string): string | null {
+  return checkoutUrl.match(/txn_[a-z0-9]+/i)?.[0] ?? null;
+}
+
+/**
+ * Opens Paddle's checkout for a server-created transaction. A "completed" callback means "Paddle took the
+ * payment" — it never unlocks anything by itself: callers re-read the server's state afterwards.
+ */
+export async function openCheckout(transactionId: string, handlers: Handlers): Promise<void> {
+  if (!TOKEN) throw new Error("payments not configured");
+  current = handlers;
+  if (!paddle) {
+    paddle = initializePaddle({
+      environment: ENV,
+      token: TOKEN,
+      eventCallback: (event) => {
+        if (event.name === CheckoutEventNames.CHECKOUT_COMPLETED) current?.onCompleted();
+        else if (event.name === CheckoutEventNames.CHECKOUT_CLOSED) current?.onClosed();
+      },
+    });
+  }
+  const instance = await paddle;
+  if (!instance) throw new Error("checkout unavailable");
+  instance.Checkout.open({ transactionId });
+}
