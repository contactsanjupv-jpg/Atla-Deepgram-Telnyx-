@@ -0,0 +1,59 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { X } from "lucide-react";
+import { api, describeError, TranscriptSegment } from "@/lib/api";
+
+export function clock(seconds: number | null): string {
+  if (seconds == null) return "";
+  const m = Math.floor(seconds / 60);
+  return `${m}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;
+}
+
+/** The full conversation as Retell recorded it: who spoke, what they said, and when (only when Retell gave a time). */
+export function TranscriptDialog({ orgId, callId, onClose }: { orgId: string; callId: string; onClose: () => void }) {
+  const [segments, setSegments] = useState<TranscriptSegment[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let live = true;
+    api
+      .getCallTranscript(orgId, callId)
+      .then((t) => live && setSegments(t.segments))
+      .catch((err) => live && setError(describeError(err, "We couldn't load this conversation.")));
+    const onKey = (e: KeyboardEvent) => e.key === "Escape" && onClose();
+    window.addEventListener("keydown", onKey);
+    return () => {
+      live = false;
+      window.removeEventListener("keydown", onKey);
+    };
+  }, [orgId, callId, onClose]);
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-end justify-center sm:items-center" role="dialog" aria-modal="true" aria-label="Conversation">
+      <button type="button" aria-label="Close" tabIndex={-1} className="absolute inset-0 bg-black/40" onClick={onClose} />
+      <div className="relative flex max-h-[85vh] w-full flex-col rounded-t-2xl bg-[var(--color-paper-raised)] p-5 shadow-xl sm:max-w-lg sm:rounded-2xl">
+        <div className="flex items-center justify-between">
+          <h2 className="text-[16px] font-semibold">Conversation</h2>
+          <button onClick={onClose} aria-label="Close" className="rounded-lg p-1.5 hover:bg-[var(--color-line)]">
+            <X className="h-5 w-5" strokeWidth={1.75} />
+          </button>
+        </div>
+        <div className="mt-3 min-h-0 flex-1 space-y-3 overflow-y-auto">
+          {error && <p className="text-[13.5px] text-[#7a2416]">{error}</p>}
+          {!error && segments === null && <p className="text-[13.5px] text-[var(--color-ink-soft)]">Loading…</p>}
+          {segments?.length === 0 && <p className="text-[13.5px] text-[var(--color-ink-soft)]">No conversation was recorded for this call.</p>}
+          {segments?.map((s, i) => (
+            <div key={i} className="text-[13.5px]">
+              <div className="flex items-baseline gap-2 text-[12px] text-[var(--color-ink-soft)]">
+                <span className="font-semibold text-[var(--color-ink)]">{s.speaker}</span>
+                {s.start_seconds != null && <span>{clock(s.start_seconds)}</span>}
+              </div>
+              <p className="mt-0.5 break-words">{s.text}</p>
+            </div>
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/credits/AnalyticsPanel.tsx b/frontend/src/components/credits/AnalyticsPanel.tsx
new file mode 100644
index 0000000..6e2fb46
--- /dev/null
+++ b/frontend/src/components/credits/AnalyticsPanel.tsx
@@ -0,0 +1,62 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { api, AnalyticsOut, describeError } from "@/lib/api";
+import { browserTimeZone, minutesLabel } from "@/lib/credits";
+import { useFeatures } from "@/lib/useFeatures";
+import { UsageChart } from "./UsageChart";
+
+/** Growth analytics: real 30-day trends and leads still waiting for a follow-up. Starter sees what it adds, with no fake numbers. */
+export function AnalyticsPanel({ orgId }: { orgId: string }) {
+  const { features } = useFeatures(orgId);
+  const allowed = features?.has("analytics") ?? false;
+  const [data, setData] = useState<AnalyticsOut | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (!allowed) return;
+    let live = true;
+    api
+      .getAnalytics(orgId, 30, browserTimeZone())
+      .then((d) => live && setData(d))
+      .catch((err) => live && setError(describeError(err, "We couldn't load analytics.")));
+    return () => {
+      live = false;
+    };
+  }, [orgId, allowed]);
+
+  if (features === null) return null;
+  if (!allowed) {
+    return (
+      <section className="mt-6 rounded-2xl border border-dashed border-[var(--color-line)] p-5">
+        <h2 className="text-[15px] font-semibold">Analytics</h2>
+        <p className="mt-1 text-[13.5px] text-[var(--color-ink-soft)]">30-day call, minute and lead trends, and leads waiting for a follow-up, are part of the Growth plan.</p>
+      </section>
+    );
+  }
+  return (
+    <section className="mt-6 min-w-0 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper-raised)] p-5 sm:p-6">
+      <h2 className="text-[15px] font-semibold">Analytics · last 30 days</h2>
+      {error && <p className="mt-2 text-[13.5px] text-[#7a2416]">{error}</p>}
+      {!error && !data && <div className="mt-3 h-24 animate-pulse rounded-lg bg-[var(--color-line)]/50" />}
+      {data && (
+        <>
+          <div className="mt-3 grid grid-cols-3 gap-3 text-[13px]">
+            <div><div className="text-[20px] font-bold">{data.total_calls}</div>calls</div>
+            <div><div className="text-[20px] font-bold">{minutesLabel(data.total_credit_seconds)}</div>used</div>
+            <div><div className="text-[20px] font-bold">{data.total_leads}</div>leads</div>
+          </div>
+          <div className="mt-5 grid gap-5 sm:grid-cols-2">
+            <UsageChart title="Calls per day" points={data.series.map((d) => ({ date: d.date, calls: d.calls, credit_seconds: d.credit_seconds }))} pick={(p) => p.calls} format={String} emptyText="No calls in the last 30 days." />
+            <UsageChart title="Leads per day" points={data.series.map((d) => ({ date: d.date, calls: d.leads, credit_seconds: 0 }))} pick={(p) => p.calls} format={String} emptyText="No leads in the last 30 days." />
+          </div>
+          <p className="mt-4 text-[13.5px]">
+            {data.leads_awaiting_follow_up === 0
+              ? "No leads are waiting for a follow-up."
+              : `${data.leads_awaiting_follow_up} lead${data.leads_awaiting_follow_up === 1 ? " is" : "s are"} waiting for a follow-up${data.oldest_unattended_lead_at ? `, the oldest since ${new Date(data.oldest_unattended_lead_at).toLocaleDateString()}` : ""}.`}
+          </p>
+        </>
+      )}
+    </section>
+  );
+}
diff --git a/frontend/src/components/credits/CreditsPanel.tsx b/frontend/src/components/credits/CreditsPanel.tsx
new file mode 100644
index 0000000..9a661cc
--- /dev/null
+++ b/frontend/src/components/credits/CreditsPanel.tsx
@@ -0,0 +1,252 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { AlertTriangle, Plus } from "lucide-react";
+import { api, CreditEvent, CreditsOut, DailyPoint, describeError } from "@/lib/api";
+import { browserTimeZone, creditBanner, creditView, dayLabel, EVENT_LABEL, formatDollars, minutesLabel } from "@/lib/credits";
+import { UsageChart } from "./UsageChart";
+import { TopupDialog } from "./TopupDialog";
+
+const RANGES = [
+  { days: 1, label: "Today" },
+  { days: 7, label: "7 days" },
+  { days: 30, label: "30 days" },
+] as const;
+
+/** Credits and usage: real balance, real daily usage, a working "Buy more credits". Nothing here is estimated. */
+export function CreditsPanel({ orgId, isOwner }: { orgId: string; isOwner: boolean }) {
+  const [credits, setCredits] = useState<CreditsOut | null>(null);
+  const [events, setEvents] = useState<CreditEvent[]>([]);
+  const [points, setPoints] = useState<DailyPoint[]>([]);
+  const [days, setDays] = useState<number>(7);
+  const [error, setError] = useState<string | null>(null);
+  const [chartError, setChartError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [dialog, setDialog] = useState(false);
+  const [waiting, setWaiting] = useState<null | "polling" | "slow">(null);
+  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  const fetchCredits = useCallback(
+    () => Promise.all([api.getCredits(orgId), api.getCreditEvents(orgId).catch(() => [] as CreditEvent[])]),
+    [orgId],
+  );
+  const loadCredits = useCallback(async () => {
+    const [c, e] = await fetchCredits();
+    setCredits(c);
+    setEvents(e);
+    return { c, e };
+  }, [fetchCredits]);
+
+  useEffect(() => {
+    let live = true;
+    fetchCredits()
+      .then(([c, e]) => {
+        if (!live) return;
+        setCredits(c);
+        setEvents(e);
+        setError(null);
+      })
+      .catch((err) => live && setError(describeError(err, "We couldn't load your credits.")))
+      .finally(() => live && setLoading(false));
+    return () => {
+      live = false;
+    };
+  }, [fetchCredits]);
+
+  useEffect(() => {
+    let live = true;
+    api
+      .getDailyUsage(orgId, days, browserTimeZone())
+      .then((p) => {
+        if (!live) return;
+        setPoints(p);
+        setChartError(null);
+      })
+      .catch((err) => live && setChartError(describeError(err, "We couldn't load usage.")));
+    return () => {
+      live = false;
+    };
+  }, [orgId, days]);
+
+  useEffect(() => () => {
+    if (pollRef.current) clearInterval(pollRef.current);
+  }, []);
+
+  // After Paddle says the payment went through, the server adds credits when ITS confirmation arrives. Poll for it.
+  function waitForCredits() {
+    setDialog(false);
+    setWaiting("polling");
+    const before = events.filter((e) => e.kind === "topup").length;
+    let tries = 0;
+    if (pollRef.current) clearInterval(pollRef.current);
+    pollRef.current = setInterval(async () => {
+      tries += 1;
+      try {
+        const { e } = await loadCredits();
+        if (e.filter((x) => x.kind === "topup").length > before) {
+          clearInterval(pollRef.current!);
+          setWaiting(null);
+          return;
+        }
+      } catch {
+        /* keep trying */
+      }
+      if (tries >= 20) {
+        clearInterval(pollRef.current!);
+        setWaiting("slow");
+      }
+    }, 3000);
+  }
+
+  if (loading) {
+    return <div className="mt-6 h-40 animate-pulse rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper-raised)]" aria-label="Loading credits" />;
+  }
+  if (error || !credits) {
+    return (
+      <section className="mt-6 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper-raised)] p-5">
+        <h2 className="text-[15px] font-semibold">Credits and usage</h2>
+        <p className="mt-1.5 text-[13.5px] text-[#7a2416]">{error ?? "We couldn't load your credits."}</p>
+        <button
+          onClick={() => {
+            setLoading(true);
+            loadCredits()
+              .then(() => setError(null))
+              .catch((err) => setError(describeError(err, "We couldn't load your credits.")))
+              .finally(() => setLoading(false));
+          }}
+          className="mt-3 rounded-full border border-[var(--color-line)] px-4 py-1.5 text-[13px] font-medium"
+        >
+          Try again
+        </button>
+      </section>
+    );
+  }
+
+  const view = creditView(credits);
+  const banner = creditBanner(credits);
+  const canBuy = isOwner && credits.entitled;
+
+  return (
+    <section className="mt-6 min-w-0 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper-raised)] p-5 sm:p-6" aria-labelledby="credits-h">
+      <div className="flex flex-wrap items-start justify-between gap-3">
+        <h2 id="credits-h" className="text-[15px] font-semibold">
+          Credits and usage
+        </h2>
+        {canBuy && (
+          <button
+            onClick={() => setDialog(true)}
+            className="flex items-center gap-1.5 rounded-full bg-[var(--color-ink)] px-4 py-2 text-[13px] font-medium text-[var(--color-paper)]"
+          >
+            <Plus className="h-3.5 w-3.5" /> Buy more credits
+          </button>
+        )}
+      </div>
+
+      {waiting === "polling" && (
+        <p role="status" className="mt-3 rounded-lg bg-[var(--color-line)]/50 px-3.5 py-2.5 text-[13.5px]">
+          Payment received. Adding your credits…
+        </p>
+      )}
+      {waiting === "slow" && (
+        <p role="status" className="mt-3 rounded-lg bg-[var(--color-line)]/50 px-3.5 py-2.5 text-[13.5px]">
+          Your payment is confirmed on Paddle&apos;s side and your credits are on the way. This can take a few minutes — refresh this page shortly. You won&apos;t be charged twice.
+        </p>
+      )}
+
+      {banner && (
+        <div
+          role="alert"
+          className={`mt-4 flex gap-2.5 rounded-xl border px-4 py-3 text-[13.5px] ${banner.tone === "empty" ? "border-[#7a2416]/30 bg-[#7a2416]/5" : "border-[var(--color-line)] bg-[var(--color-line)]/40"}`}
+        >
+          <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" strokeWidth={1.75} />
+          <div className="min-w-0">
+            <div className="font-medium">{banner.title}</div>
+            <div className="text-[var(--color-ink-soft)]">{banner.body}</div>
+            {!isOwner && <div className="mt-1 text-[var(--color-ink-soft)]">Ask the account owner to add credits.</div>}
+          </div>
+        </div>
+      )}
+
+      {view.kind === "unmetered" ? (
+        <div className="mt-4 text-[13.5px] text-[var(--color-ink-soft)]">
+          {credits.free_test_calls_remaining > 0
+            ? `You have ${credits.free_test_calls_remaining} free test call${credits.free_test_calls_remaining === 1 ? "" : "s"} included. Choose a plan to start taking real calls.`
+            : "Your free test call has been used. Choose a plan to keep testing and take real calls."}
+        </div>
+      ) : (
+        <>
+          <div className="mt-4 flex flex-wrap items-baseline gap-x-6 gap-y-1">
+            <div>
+              <span className="text-[28px] font-bold tracking-tight">{view.remaining}</span>
+              <span className="ml-1.5 text-[13.5px] text-[var(--color-ink-soft)]">available</span>
+            </div>
+            <div className="text-[13px] text-[var(--color-ink-soft)]">
+              {view.used} of {view.granted} included used
+              {view.purchased !== "0 min" && <> · {view.purchased} purchased</>}
+              {view.owes && <> · {view.owes} owed</>}
+            </div>
+          </div>
+          <div className="mt-3 h-2 overflow-hidden rounded-full bg-[var(--color-line)]" role="progressbar" aria-valuemin={0} aria-valuemax={100} aria-valuenow={view.usedPercent} aria-label="Included minutes used">
+            <div className="h-full rounded-full bg-[var(--color-ink)]" style={{ width: `${view.usedPercent}%` }} />
+          </div>
+          {credits.period_end && (
+            <p className="mt-2 text-[12.5px] text-[var(--color-ink-soft)]">Included minutes renew {dayLabel(credits.period_end.slice(0, 10))}.</p>
+          )}
+          <p className="mt-1 text-[12.5px] text-[var(--color-ink-soft)]">{credits.when_credits_run_out}</p>
+        </>
+      )}
+
+      <div className="mt-6 flex items-center justify-between gap-3">
+        <h3 className="text-[13.5px] font-semibold">Usage</h3>
+        <div role="tablist" aria-label="Usage range" className="flex rounded-full border border-[var(--color-line)] p-0.5">
+          {RANGES.map((r) => (
+            <button
+              key={r.days}
+              role="tab"
+              aria-selected={days === r.days}
+              onClick={() => setDays(r.days)}
+              className={`rounded-full px-3 py-1 text-[12.5px] font-medium ${days === r.days ? "bg-[var(--color-ink)] text-[var(--color-paper)]" : "text-[var(--color-ink-soft)]"}`}
+            >
+              {r.label}
+            </button>
+          ))}
+        </div>
+      </div>
+      {chartError ? (
+        <p className="mt-3 text-[13px] text-[#7a2416]">{chartError}</p>
+      ) : (
+        <div className="mt-3 grid gap-5 sm:grid-cols-2">
+          <UsageChart title="Calls" points={points} pick={(p) => p.calls} format={(v) => String(v)} emptyText="No calls in this period yet." />
+          <UsageChart title="Minutes used" points={points} pick={(p) => p.credit_seconds} format={(v) => minutesLabel(v)} emptyText="No minutes used in this period yet." />
+        </div>
+      )}
+
+      <h3 className="mt-6 text-[13.5px] font-semibold">Credit activity</h3>
+      {events.length === 0 ? (
+        <p className="mt-2 text-[13px] text-[var(--color-ink-soft)]">Nothing yet. Monthly minutes and purchases will show here.</p>
+      ) : (
+        <ul className="mt-2 divide-y divide-[var(--color-line)]">
+          {events.map((e) => (
+            <li key={e.id} className="flex items-baseline justify-between gap-3 py-2 text-[13px]">
+              <span className="min-w-0 truncate">
+                {EVENT_LABEL[e.kind] ?? e.kind}
+                <span className="ml-2 text-[var(--color-ink-soft)]">{new Date(e.occurred_at).toLocaleDateString(undefined, { month: "short", day: "numeric" })}</span>
+              </span>
+              <span className={`shrink-0 font-medium ${e.seconds < 0 ? "text-[#7a2416]" : ""}`}>
+                {e.seconds < 0 ? "−" : "+"}
+                {minutesLabel(e.seconds)}
+              </span>
+            </li>
+          ))}
+        </ul>
+      )}
+      {canBuy && (
+        <p className="mt-3 text-[12px] text-[var(--color-ink-soft)]">
+          Minimum top-up {formatDollars(credits.topup_min_minor)}. Credits you buy never expire.
+        </p>
+      )}
+
+      {dialog && <TopupDialog orgId={orgId} minMinor={credits.topup_min_minor} maxMinor={credits.topup_max_minor} onClose={() => setDialog(false)} onPaid={waitForCredits} />}
+    </section>
+  );
+}
diff --git a/frontend/src/components/credits/TopupDialog.tsx b/frontend/src/components/credits/TopupDialog.tsx
new file mode 100644
index 0000000..31a19fd
--- /dev/null
+++ b/frontend/src/components/credits/TopupDialog.tsx
@@ -0,0 +1,175 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { X } from "lucide-react";
+import { api, describeError, TopupQuote } from "@/lib/api";
+import { formatDollars, quickAmounts, validateTopup } from "@/lib/credits";
+import { openCheckout, paymentsConfigured, transactionIdFrom } from "@/lib/paddle";
+
+/**
+ * Buy more credits: the customer picks any amount from the minimum up, sees what it buys BEFORE paying, and
+ * pays through Paddle. Nothing is credited here — the server grants credits only after Paddle confirms payment.
+ */
+export function TopupDialog({
+  orgId,
+  minMinor,
+  maxMinor,
+  onClose,
+  onPaid,
+}: {
+  orgId: string;
+  minMinor: number;
+  maxMinor: number;
+  onClose: () => void;
+  onPaid: () => void;
+}) {
+  const [text, setText] = useState(String(minMinor / 100));
+  const [quote, setQuote] = useState<TopupQuote | null>(null);
+  const [quoteError, setQuoteError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const inputRef = useRef<HTMLInputElement>(null);
+
+  const check = validateTopup(text, minMinor, maxMinor);
+  const amount = check.ok ? check.amountMinor : null;
+
+  useEffect(() => {
+    inputRef.current?.focus();
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape" && !busy) onClose();
+    };
+    const prev = document.body.style.overflow;
+    document.body.style.overflow = "hidden";
+    window.addEventListener("keydown", onKey);
+    return () => {
+      window.removeEventListener("keydown", onKey);
+      document.body.style.overflow = prev;
+    };
+  }, [busy, onClose]);
+
+  // What this amount buys, from the server (it owns the rate). Debounced so typing doesn't spam the API.
+  useEffect(() => {
+    if (amount === null) return;
+    let live = true;
+    const t = setTimeout(() => {
+      api
+        .getTopupQuote(orgId, amount)
+        .then((q) => {
+          if (!live) return;
+          setQuote(q);
+          setQuoteError(null);
+        })
+        .catch((err) => {
+          if (!live) return;
+          setQuote(null);
+          setQuoteError(describeError(err, "We couldn't work out your credits right now."));
+        });
+    }, 300);
+    return () => {
+      live = false;
+      clearTimeout(t);
+    };
+  }, [amount, orgId]);
+
+  const quoteMatches = quote !== null && amount !== null && quote.amount_minor === amount;
+
+  async function pay() {
+    if (amount === null || !quoteMatches) return;
+    if (!paymentsConfigured) {
+      setError("Payments aren't configured yet.");
+      return;
+    }
+    setBusy(true);
+    setError(null);
+    try {
+      const { checkout_url } = await api.createTopup(orgId, amount);
+      const txn = transactionIdFrom(checkout_url);
+      if (!txn) throw new Error("checkout unavailable");
+      await openCheckout(txn, {
+        onCompleted: () => {
+          setBusy(false);
+          onPaid();
+        },
+        onClosed: () => setBusy(false),
+      });
+    } catch (err) {
+      setBusy(false);
+      setError(describeError(err, "We couldn't start your purchase. You haven't been charged."));
+    }
+  }
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-end justify-center sm:items-center" role="dialog" aria-modal="true" aria-label="Buy more credits">
+      <button type="button" aria-label="Close" tabIndex={-1} className="absolute inset-0 bg-black/40" onClick={() => !busy && onClose()} />
+      <div className="relative max-h-[90vh] w-full overflow-y-auto rounded-t-2xl bg-[var(--color-paper-raised)] p-6 shadow-xl sm:max-w-md sm:rounded-2xl">
+        <div className="flex items-start justify-between gap-4">
+          <div>
+            <h2 className="text-[18px] font-semibold">Buy more credits</h2>
+            <p className="mt-1 text-[13.5px] text-[var(--color-ink-soft)]">Choose any amount from {formatDollars(minMinor)}. Credits never expire.</p>
+          </div>
+          <button onClick={onClose} disabled={busy} aria-label="Close" className="rounded-lg p-1.5 text-[var(--color-ink-soft)] hover:bg-[var(--color-line)]">
+            <X className="h-5 w-5" strokeWidth={1.75} />
+          </button>
+        </div>
+
+        <label htmlFor="topup-amount" className="mt-5 block text-[13px] font-medium">
+          Amount (USD)
+        </label>
+        <div className="mt-1.5 flex items-center rounded-xl border border-[var(--color-line)] px-3.5 focus-within:border-[var(--color-ink)]">
+          <span className="text-[16px] text-[var(--color-ink-soft)]">$</span>
+          <input
+            id="topup-amount"
+            ref={inputRef}
+            value={text}
+            onChange={(e) => setText(e.target.value)}
+            inputMode="decimal"
+            autoComplete="off"
+            aria-invalid={!check.ok}
+            aria-describedby="topup-help"
+            className="w-full bg-transparent px-2 py-3 text-[18px] font-semibold outline-none"
+          />
+        </div>
+
+        <div className="mt-3 flex flex-wrap gap-2">
+          {quickAmounts(minMinor, maxMinor).map((a) => (
+            <button
+              key={a}
+              type="button"
+              onClick={() => setText(String(a / 100))}
+              className="rounded-full border border-[var(--color-line)] px-3.5 py-1.5 text-[13px] font-medium hover:bg-[var(--color-line)]"
+            >
+              {formatDollars(a)}
+            </button>
+          ))}
+        </div>
+
+        <p id="topup-help" aria-live="polite" className={`mt-4 min-h-[44px] text-[14px] ${check.ok && !quoteError ? "" : "text-[#7a2416]"}`}>
+          {!check.ok ? (
+            check.message
+          ) : quoteError ? (
+            quoteError
+          ) : quoteMatches ? (
+            <>
+              You&apos;ll get <strong>{quote!.credit_minutes.toLocaleString()} minutes</strong> of receptionist time for {formatDollars(quote!.amount_minor)}.
+            </>
+          ) : (
+            <span className="text-[var(--color-ink-soft)]">Working out your credits…</span>
+          )}
+        </p>
+
+        {error && <p className="mb-3 text-[13.5px] text-[#7a2416]">{error}</p>}
+
+        <button
+          onClick={pay}
+          disabled={busy || !quoteMatches}
