+++ b/backend/tests/test_credits_ledger.py
@@ -0,0 +1,267 @@
+"""The credit ledger: grants, usage attribution, balances, reporting and what happens at zero."""
+import threading
+import uuid
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from app.config import get_settings
+from app.db.base import SessionLocal
+from app.db.models.billing import CreditLedgerEntry, Subscription
+from app.db.models.telephony import PhoneNumberStatus
+from app.db.models.voice_agent import AgentStatus
+from app.services import credits
+from app.services.plans import PLANS, Plan
+from app.services.subscription_sync import sync_subscription
+from tests.billing_helpers import add_usage, new_org, now, subscribe, summary
+
+MIN = 60
+
+
+@pytest.fixture(autouse=True)
+def _paddle_prices(monkeypatch):
+    s = get_settings()
+    monkeypatch.setattr(s, "PADDLE_STARTER_PRICE_ID", "pri_starter")
+    monkeypatch.setattr(s, "PADDLE_GROWTH_PRICE_ID", "pri_growth")
+
+
+def _grants(org_id):
+    db = SessionLocal()
+    try:
+        return db.query(CreditLedgerEntry).filter_by(organization_id=uuid.UUID(org_id), kind="plan_grant").all()
+    finally:
+        db.close()
+
+
+def _snapshot(sub_id, org_id, start, end, status="active", price="pri_starter", updated=None):
+    return {
+        "id": sub_id, "status": status, "custom_data": {"organization_id": org_id},
+        "items": [{"status": "active", "quantity": 1, "price": {"id": price}}],
+        "current_billing_period": {"starts_at": start.isoformat(), "ends_at": end.isoformat()},
+        "updated_at": (updated or start).isoformat(),
+    }
+
+
+# ---------------- grants ----------------
+
+def test_monthly_grant_is_created_exactly_once_for_the_period_however_often_it_is_applied():
+    _c, org = new_org()
+    start = now() - timedelta(days=1)
+    snap = _snapshot(f"sub_{uuid.uuid4().hex[:8]}", org, start, start + timedelta(days=30))
+    for i in range(3):  # webhook, redelivered webhook, reconciler snapshot
+        db = SessionLocal()
+        sync_subscription(db, snap, start + timedelta(minutes=i))
+        db.commit()
+        db.close()
+    grants = _grants(org)
+    assert len(grants) == 1 and grants[0].seconds == PLANS["starter"].included_minutes * MIN
+
+
+def test_concurrent_application_of_one_period_still_grants_once():
+    _c, org = new_org()
+    sub_id = subscribe(org, grant=False)
+    errors = []
+
+    def apply():
+        db = SessionLocal()
+        try:
+            sub = db.query(Subscription).filter_by(external_subscription_id=sub_id).one()
+            credits.ensure_plan_grant(db, sub)
+            db.commit()
+        except Exception as e:  # noqa: BLE001
+            errors.append(e)
+        finally:
+            db.close()
+
+    threads = [threading.Thread(target=apply) for _ in range(8)]
+    [t.start() for t in threads]
+    [t.join() for t in threads]
+    assert not errors and len(_grants(org)) == 1
+
+
+def test_growth_grant_is_larger_than_starter_and_matches_the_catalog():
+    _c1, a = new_org()
+    _c2, b = new_org()
+    subscribe(a, "starter")
+    subscribe(b, "growth")
+    assert summary(b).included_granted_seconds > summary(a).included_granted_seconds
+    assert summary(a).included_granted_seconds == PLANS["starter"].included_minutes * MIN
+    assert summary(b).included_granted_seconds == PLANS["growth"].included_minutes * MIN
+
+
+def test_no_grant_for_inactive_subscriptions_or_a_period_that_already_ended():
+    _c, org = new_org()
+    subscribe(org, status="past_due")
+    assert _grants(org) == []
+    _c, org2 = new_org()
+    start = now() - timedelta(days=40)
+    sub_id = subscribe(org2, start=start, end=start + timedelta(days=30), grant=False)
+    db = SessionLocal()
+    sub = db.query(Subscription).filter_by(external_subscription_id=sub_id).one()
+    assert credits.ensure_plan_grant(db, sub) is False  # a stale snapshot of a finished period grants nothing
+    db.commit()
+    db.close()
+    assert _grants(org2) == []
+
+
+def test_each_new_billing_period_gets_its_own_grant_and_unused_minutes_do_not_roll_over():
+    _c, org = new_org()
+    p1 = now() - timedelta(days=45)
+    sub_id = subscribe(org, start=p1, end=p1 + timedelta(days=30), grant=False)
+    db = SessionLocal()
+    sub = db.query(Subscription).filter_by(external_subscription_id=sub_id).one()
+    credits.ensure_plan_grant(db, sub, now=p1 + timedelta(days=1))  # the old period's grant, made on time
+    add_usage(org, 100 * MIN, at=p1 + timedelta(days=5))
+    sub.current_period_start, sub.current_period_end = now() - timedelta(days=1), now() + timedelta(days=29)
+    db.flush()
+    credits.ensure_plan_grant(db, sub)
+    db.commit()
+    db.close()
+    s = summary(org)
+    full = PLANS["starter"].included_minutes * MIN
+    assert len(_grants(org)) == 2
+    assert s.included_granted_seconds == full and s.included_remaining_seconds == full  # no carry-over, old use not charged here
+    assert s.purchased_balance_seconds == 0
+
+
+# ---------------- usage and balance ----------------
+
+def test_a_call_consumes_credits_exactly_once_and_remaining_is_grant_minus_use():
+    _c, org = new_org()
+    subscribe(org)
+    full = PLANS["starter"].included_minutes * MIN
+    add_usage(org, 61)
+    s = summary(org)
+    assert s.included_used_seconds == 61 and s.included_remaining_seconds == full - 61 and s.available_seconds == full - 61
+
+
+def test_the_free_test_call_is_never_charged_but_a_paid_test_is():
+    _c, org = new_org()
+    subscribe(org)
+    full = PLANS["starter"].included_minutes * MIN
+    add_usage(org, 120, kind="free_test", cost=40)
+    assert summary(org).available_seconds == full
+    add_usage(org, 90, kind="test")
+    assert summary(org).available_seconds == full - 90
+
+
+def test_usage_from_before_the_first_grant_is_never_charged():
+    _c, org = new_org()
+    add_usage(org, 500, at=now() - timedelta(days=60))
+    subscribe(org)
+    full = PLANS["starter"].included_minutes * MIN
+    assert summary(org).available_seconds == full
+
+
+def test_late_usage_is_attributed_to_the_period_the_call_happened_in():
+    """Out-of-order delivery: a call from the previous period arrives after the new period's grant exists."""
+    _c, org = new_org()
+    p1 = now() - timedelta(days=45)
+    sub_id = subscribe(org, start=p1, end=p1 + timedelta(days=30), grant=False)
+    db = SessionLocal()
+    sub = db.query(Subscription).filter_by(external_subscription_id=sub_id).one()
+    credits.ensure_plan_grant(db, sub, now=p1 + timedelta(days=1))
+    sub.current_period_start, sub.current_period_end = now() - timedelta(days=1), now() + timedelta(days=29)
+    db.flush()
+    credits.ensure_plan_grant(db, sub)
+    db.commit()
+    db.close()
+    before = summary(org)
+    add_usage(org, 50 * MIN, at=p1 + timedelta(days=10))  # arrives late
+    assert summary(org).available_seconds == before.available_seconds  # charged to the OLD period, not this one
+
+
+def test_use_beyond_the_allowance_spends_the_purchased_balance_then_goes_negative(monkeypatch):
+    monkeypatch.setitem(PLANS, "starter", Plan("starter", "Starter", 1, PLANS["starter"].features, 1))
+    _c, org = new_org()
+    subscribe(org)
+    db = SessionLocal()
+    credits.add_ledger_entry(db, organization_id=uuid.UUID(org), kind="topup", seconds=5 * MIN, idempotency_key=f"t:{org}")
+    db.commit()
+    db.close()
+    add_usage(org, 3 * MIN)  # 1 min included + 2 min purchased
+    s = summary(org)
+    assert s.included_remaining_seconds == 0 and s.purchased_balance_seconds == 3 * MIN and s.available_seconds == 3 * MIN
+    add_usage(org, 6 * MIN)
+    assert summary(org).purchased_balance_seconds == -3 * MIN  # a call cannot be refused mid-flight: it goes negative
+    assert summary(org).status == "empty"
+
+
+def test_status_thresholds_ok_low_empty(monkeypatch):
+    monkeypatch.setitem(PLANS, "starter", Plan("starter", "Starter", 1, PLANS["starter"].features, 100))
+    _c, org = new_org()
+    subscribe(org)
+    assert summary(org).status == "ok"
+    add_usage(org, 85 * MIN)  # 15 of 100 minutes left, under the 20% line
+    assert summary(org).status == "low"
+    add_usage(org, 15 * MIN)
+    assert summary(org).status == "empty"
+
+
+def test_ledger_entries_are_idempotent_by_key():
+    _c, org = new_org()
+    db = SessionLocal()
+    first = credits.add_ledger_entry(db, organization_id=uuid.UUID(org), kind="topup", seconds=600, idempotency_key=f"dup:{org}")
+    second = credits.add_ledger_entry(db, organization_id=uuid.UUID(org), kind="topup", seconds=600, idempotency_key=f"dup:{org}")
+    db.commit()
+    assert first and not second
+    assert db.query(CreditLedgerEntry).filter_by(organization_id=uuid.UUID(org)).count() == 1
+    db.close()
+
+
+# ---------------- reporting ----------------
+
+def test_daily_usage_has_one_real_row_per_day_in_the_viewers_timezone():
+    _c, org = new_org()
+    subscribe(org)
+    # 23:30 UTC on the 10th is already the 11th in India (UTC+5:30)
+    add_usage(org, 120, at=datetime(2026, 10, 10, 23, 30, tzinfo=timezone.utc))
+    db = SessionLocal()
+    try:
+        ref = datetime(2026, 10, 11, 12, 0, tzinfo=timezone.utc)
+        ist = credits.daily_usage(db, uuid.UUID(org), 3, "Asia/Kolkata", now=ref)
+        utc = credits.daily_usage(db, uuid.UUID(org), 3, "UTC", now=ref)
+    finally:
+        db.close()
+    assert [d["date"] for d in ist] == ["2026-10-09", "2026-10-10", "2026-10-11"]
+    assert {d["date"]: d["calls"] for d in ist}["2026-10-11"] == 1
+    assert {d["date"]: d["calls"] for d in utc}["2026-10-10"] == 1
+    assert ist[0]["calls"] == 0 and ist[0]["credit_seconds"] == 0  # empty days are real zeros
+
+
+def test_unknown_timezone_falls_back_to_utc_instead_of_failing():
+    assert credits.resolve_timezone("Not/AZone").key == "UTC"
+    assert credits.resolve_timezone(None).key == "UTC"
+
+
+# ---------------- what happens at zero ----------------
+
+def test_credits_exhausted_beyond_the_grace_pauses_the_receptionist_but_keeps_the_number(monkeypatch):
+    from app.services.entitlement import enforce_entitlements
+    from tests.fakes import FakePhone
+    from tests.test_call_pipeline import _seed
+
+    monkeypatch.setitem(PLANS, "starter", Plan("starter", "Starter", 1, PLANS["starter"].features, 1))
+    monkeypatch.setattr(get_settings(), "OVERAGE_GRACE_MINUTES", 30)
+    _c, org = new_org()
+    _agent, number = _seed(org)
+    subscribe(org)
+    provider = FakePhone()
+    provider.numbers[number] = {"nickname": "n", "agent": "agent_x"}
+    db = SessionLocal()
+    try:
+        add_usage(org, 20 * MIN)  # 19 min over: inside the 30-minute grace -> still live
+        enforce_entitlements(db, provider, organization_ids={uuid.UUID(org)})
+        assert db.query(__import__("app.db.models.voice_agent", fromlist=["Agent"]).Agent).filter_by(organization_id=uuid.UUID(org)).one().status == AgentStatus.active
+        add_usage(org, 20 * MIN)  # now 39 min over
+        result = enforce_entitlements(db, provider, organization_ids={uuid.UUID(org)})
+        db.expire_all()
+        from app.db.models.telephony import PhoneNumber
+        from app.db.models.voice_agent import Agent
+
+        assert db.query(Agent).filter_by(organization_id=uuid.UUID(org)).one().status == AgentStatus.paused
+        phone = db.query(PhoneNumber).filter_by(organization_id=uuid.UUID(org)).one()
+        assert phone.agent_id is None and phone.status == PhoneNumberStatus.active  # paused, NOT released
+        assert provider.unassigns and result["released"] == 0
+    finally:
+        db.close()
diff --git a/backend/tests/test_entitlements.py b/backend/tests/test_entitlements.py
new file mode 100644
index 0000000..7916f08
--- /dev/null
+++ b/backend/tests/test_entitlements.py
@@ -0,0 +1,215 @@
+"""Server-side plan enforcement + plan mapping from Paddle PRICE ids (not client data)."""
+import uuid
+from types import SimpleNamespace
+
+import pytest
+from fastapi import HTTPException
+
+from app.config import get_settings
+from app.services import plans
+from app.services.plans import PLANS, Feature, Plan
+from tests.test_billing import SECRET, _new_org, _post  # noqa: F401  (SECRET used by fixture below)
+
+
+@pytest.fixture(autouse=True)
+def _paddle_settings(monkeypatch):
+    s = get_settings()
+    monkeypatch.setattr(s, "PADDLE_WEBHOOK_SECRET", SECRET)
+    monkeypatch.setattr(s, "PADDLE_API_KEY", "test_key")
+    monkeypatch.setattr(s, "PADDLE_ENV", "sandbox")
+    monkeypatch.setattr(s, "PADDLE_STARTER_PRICE_ID", "pri_starter")
+    monkeypatch.setattr(s, "PADDLE_GROWTH_PRICE_ID", "pri_growth")
+
+
+def _ev(event_type, sub_id, org_id, price_id=None, status="active", custom_plan=None, at="2026-10-01T00:00:00.000000Z"):
+    data = {
+        "id": sub_id,
+        "status": status,
+        "custom_data": {"organization_id": org_id, **({"plan_id": custom_plan} if custom_plan else {})},
+        "current_billing_period": {"starts_at": "2026-10-01T00:00:00Z", "ends_at": "2026-11-01T00:00:00Z"},
+    }
+    if price_id:
+        data["items"] = [{"status": "active", "quantity": 1, "price": {"id": price_id}}]
+    return {
+        "event_id": f"evt_{uuid.uuid4().hex}",
+        "event_type": event_type,
+        "occurred_at": at,
+        "notification_id": f"ntf_{uuid.uuid4().hex}",
+        "data": data,
+    }
+
+
+def _plan_of(db, org_id):
+    from app.services.billing_state import current_subscription
+
+    db.rollback()
+    sub = current_subscription(db, uuid.UUID(org_id))
+    return sub.plan_id if sub else None
+
+
+def _gate(db, org_id, feature):
+    dep = __import__("app.auth.deps", fromlist=["require_feature"]).require_feature(feature)
+    return dep(membership=SimpleNamespace(organization_id=uuid.UUID(org_id)), db=db)
+
+
+@pytest.fixture
+def tiered_plans(monkeypatch):
+    """Registers a Growth-only feature for the test so the Starter/Growth matrix is exercised for real."""
+    starter_only, growth_only = "x_starter_feature", "x_growth_feature"
+    base = set(plans.STARTER_FEATURES)
+    monkeypatch.setitem(PLANS, "starter", Plan("starter", "Starter", 1, frozenset(base | {starter_only})))
+    monkeypatch.setitem(PLANS, "growth", Plan("growth", "Growth", 2, frozenset(base | {starter_only, growth_only})))
+    return starter_only, growth_only
+
+
+# ---------- catalog invariants ----------
+
+def test_growth_inherits_every_starter_feature():
+    assert PLANS["starter"].features <= PLANS["growth"].features
+
+
+def test_every_plan_has_a_configured_price():
+    for plan_id in PLANS:
+        assert plans.price_id_for_plan(plan_id)
+    assert plans.plan_id_for_price("pri_starter") == "starter"
+    assert plans.plan_id_for_price("pri_growth") == "growth"
+    assert plans.plan_id_for_price("pri_other") is None
+    assert plans.plan_id_for_price("") is None
+
+
+# ---------- the entitlement matrix (server-side dependency) ----------
+
+def test_starter_gets_starter_feature_but_not_growth_feature(db, tiered_plans):
+    starter_f, growth_f = tiered_plans
+    _c, org = _new_org()
+    _post(_ev("subscription.created", f"sub_{uuid.uuid4().hex[:12]}", org, "pri_starter"))
+    db.rollback()
+    assert _gate(db, org, starter_f) is not None
+    with pytest.raises(HTTPException) as exc:
+        _gate(db, org, growth_f)
+    assert exc.value.status_code == 402
+    assert exc.value.detail == "This feature is available on Growth. Upgrade to unlock it."
+
+
+def test_growth_gets_starter_and_growth_features(db, tiered_plans):
+    starter_f, growth_f = tiered_plans
+    _c, org = _new_org()
+    _post(_ev("subscription.created", f"sub_{uuid.uuid4().hex[:12]}", org, "pri_growth"))
+    db.rollback()
+    assert _gate(db, org, starter_f) is not None
+    assert _gate(db, org, growth_f) is not None
+    assert _gate(db, org, Feature.phone_number) is not None
+
+
+def test_no_subscription_is_rejected_for_every_real_feature(db):
+    _c, org = _new_org()
+    for feature in Feature:
+        with pytest.raises(HTTPException) as exc:
+            _gate(db, org, feature)
+        assert exc.value.status_code == 402
+
+
+@pytest.mark.parametrize("bad_status", ["past_due", "paused", "canceled"])
+def test_lapsed_subscription_loses_features(db, bad_status):
+    _c, org = _new_org()
+    sub = f"sub_{uuid.uuid4().hex[:12]}"
+    _post(_ev("subscription.created", sub, org, "pri_starter"))
+    db.rollback()
+    assert _gate(db, org, Feature.go_live) is not None
+    _post(_ev("subscription.updated", sub, org, "pri_starter", status=bad_status, at="2026-10-02T00:00:00Z"))
+    db.rollback()
+    with pytest.raises(HTTPException) as exc:
+        _gate(db, org, Feature.go_live)
+    assert exc.value.status_code == 402
+
+
+def test_recovery_from_past_due_restores_features(db):
+    _c, org = _new_org()
+    sub = f"sub_{uuid.uuid4().hex[:12]}"
+    _post(_ev("subscription.created", sub, org, "pri_starter"))
+    _post(_ev("subscription.updated", sub, org, "pri_starter", status="past_due", at="2026-10-02T00:00:00Z"))
+    db.rollback()
+    with pytest.raises(HTTPException):
+        _gate(db, org, Feature.phone_number)
+    _post(_ev("subscription.updated", sub, org, "pri_starter", status="active", at="2026-10-03T00:00:00Z"))
+    db.rollback()
+    assert _gate(db, org, Feature.phone_number) is not None
+
+
+def test_entitlements_do_not_leak_between_orgs(db, tiered_plans):
+    _starter_f, growth_f = tiered_plans
+    _a, org_a = _new_org()
+    _b, org_b = _new_org()
+    _post(_ev("subscription.created", f"sub_{uuid.uuid4().hex[:12]}", org_a, "pri_growth"))
+    db.rollback()
+    assert _gate(db, org_a, growth_f) is not None
+    with pytest.raises(HTTPException):
+        _gate(db, org_b, growth_f)
+
+
+def test_unrecognised_plan_gets_no_features_even_if_active(db):
+    _c, org = _new_org()
+    _post(_ev("subscription.created", f"sub_{uuid.uuid4().hex[:12]}", org, "pri_not_ours"))
+    assert _plan_of(db, org) == "unknown"
+    with pytest.raises(HTTPException) as exc:
+        _gate(db, org, Feature.phone_number)
+    assert exc.value.status_code == 402
+
+
+# ---------- endpoints enforce it too (direct API calls, no UI) ----------
+
+def test_phone_and_activate_endpoints_are_402_without_a_plan():
+    c, org = _new_org()
+    assert c.post(f"/api/v1/orgs/{org}/phone-numbers", json={"country": "US", "area_code": "305"}).status_code == 402
+    body = {"agent_id": str(uuid.uuid4()), "phone_number_id": str(uuid.uuid4())}
+    assert c.post(f"/api/v1/orgs/{org}/activate", json=body).status_code == 402
+
+
+def test_unrecognised_plan_is_402_at_the_endpoint():
+    c, org = _new_org()
+    _post(_ev("subscription.created", f"sub_{uuid.uuid4().hex[:12]}", org, "pri_not_ours"))
+    resp = c.post(f"/api/v1/orgs/{org}/phone-numbers", json={"country": "US", "area_code": "305"})
+    assert resp.status_code == 402
+    assert "plan" in resp.json()["detail"].lower()
+
+
+# ---------- plan comes from the PRICE, not from client-supplied data ----------
+
+def test_price_beats_custom_data_on_create(db):
+    """Paddle.js lets a client pass customData; a Starter price with customData plan=growth must still be Starter."""
+    _c, org = _new_org()
+    _post(_ev("subscription.created", f"sub_{uuid.uuid4().hex[:12]}", org, "pri_starter", custom_plan="growth"))
+    assert _plan_of(db, org) == "starter"
+
+
+def test_payload_without_items_falls_back_to_custom_data(db):
+    _c, org = _new_org()
+    _post(_ev("subscription.created", f"sub_{uuid.uuid4().hex[:12]}", org, None, custom_plan="starter"))
+    assert _plan_of(db, org) == "starter"
+
+
+def test_upgrade_and_downgrade_follow_the_price(db):
+    _c, org = _new_org()
+    sub = f"sub_{uuid.uuid4().hex[:12]}"
+    _post(_ev("subscription.created", sub, org, "pri_starter", custom_plan="starter"))
+    assert _plan_of(db, org) == "starter"
+    _post(_ev("subscription.updated", sub, org, "pri_growth", custom_plan="starter", at="2026-10-02T00:00:00Z"))
+    assert _plan_of(db, org) == "growth"
+    _post(_ev("subscription.updated", sub, org, "pri_starter", custom_plan="starter", at="2026-10-03T00:00:00Z"))
+    assert _plan_of(db, org) == "starter"
+
+
+def test_stale_plan_change_is_ignored(db):
+    _c, org = _new_org()
+    sub = f"sub_{uuid.uuid4().hex[:12]}"
+    _post(_ev("subscription.created", sub, org, "pri_starter", at="2026-10-01T00:00:00Z"))
+    _post(_ev("subscription.updated", sub, org, "pri_growth", at="2026-10-03T00:00:00Z"))
+    _post(_ev("subscription.updated", sub, org, "pri_starter", at="2026-10-02T00:00:00Z"))  # late, older
+    assert _plan_of(db, org) == "growth"
+
+
+def test_mixed_or_foreign_prices_fail_closed():
+    assert plans.plan_id_from_items([{"price": {"id": "pri_starter"}}, {"price": {"id": "pri_other"}}]) == "unknown"
+    assert plans.plan_id_from_items([{"price": {"id": "pri_starter"}}, {"price": {"id": "pri_growth"}}]) == "unknown"
+    assert plans.plan_id_from_items([]) is None
+    assert plans.plan_id_from_items(None) is None
