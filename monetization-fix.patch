new file mode 100644
index 0000000..86cffa1
--- /dev/null
+++ b/backend/app/services/free_test.py
@@ -0,0 +1,64 @@
+"""
+The promised free test call. A prospect gets exactly FREE_TEST_CALLS_PER_ORG of them, ever.
+
+The allowance is a ROW, not a counter: `free_test_allowances` is unique on (organization, slot) and on
+(user, slot). Claiming a slot is an INSERT that either succeeds or violates a constraint, so two
+simultaneous requests can never both get it, a page refresh / second receptionist / new sign-in cannot
+reset it, and the same person cannot collect one per organization. Nothing here trusts the browser.
+
+Only the customer's access is free: the real Retell cost of the call is still recorded in usage_ledger
+(kind "free_test") so it can be measured (python -m app.workers.pricing_report).
+
+Known limit: the call's length is capped by the browser (TEST_CALL_MAX_SECONDS) and, server-side, by the
+agent's AGENT_MAX_CALL_SECONDS — so the worst case for one free call is that many seconds of provider cost.
+"""
+import logging
+import uuid
+
+from sqlalchemy import func
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Session
+
+from app.config import get_settings
+from app.db.models.billing import FreeTestAllowance
+
+logger = logging.getLogger("atla.free_test")
+
+
+def reserve(db: Session, organization_id: uuid.UUID, user_id: uuid.UUID) -> FreeTestAllowance | None:
+    """Claims the next free slot, or returns None when none is left for this org / user."""
+    for slot in range(get_settings().FREE_TEST_CALLS_PER_ORG):
+        row = FreeTestAllowance(organization_id=organization_id, user_id=user_id, slot=slot)
+        try:
+            with db.begin_nested():
+                db.add(row)
+                db.flush()
+            return row
+        except IntegrityError:
+            continue
+    return None
+
+
+def release(db: Session, allowance: FreeTestAllowance) -> None:
+    """Gives the slot back — only when the call provably never happened (provider refused it)."""
+    db.delete(allowance)
+    db.flush()
+
+
+def release_if_never_connected(db: Session, retell_call_id: str) -> bool:
+    """A free call that ended with zero seconds never reached the receptionist: the customer did not get to try it."""
+    row = db.query(FreeTestAllowance).filter(FreeTestAllowance.retell_call_id == retell_call_id).first()
+    if row is None:
+        return False
+    db.delete(row)
+    db.flush()
+    return True
+
+
+def remaining(db: Session, organization_id: uuid.UUID, user_id: uuid.UUID | None) -> int:
+    total = get_settings().FREE_TEST_CALLS_PER_ORG
+    used_org = db.query(func.count(FreeTestAllowance.id)).filter(FreeTestAllowance.organization_id == organization_id).scalar()
+    used_user = (
+        db.query(func.count(FreeTestAllowance.id)).filter(FreeTestAllowance.user_id == user_id).scalar() if user_id else 0
+    )
+    return max(0, total - max(used_org, used_user))
diff --git a/backend/app/services/plan_pricing.py b/backend/app/services/plan_pricing.py
new file mode 100644
index 0000000..77202a2
--- /dev/null
+++ b/backend/app/services/plan_pricing.py
@@ -0,0 +1,66 @@
+"""
+The price shown to customers is the price of the Paddle price object behind the
+plan (PADDLE_*_PRICE_ID) — read from Paddle, cached briefly in Redis. Nothing in
+this codebase hardcodes an amount. If Paddle can't be read, the price is None and
+the UI shows no number rather than a wrong one.
+"""
+import json
+import logging
+
+import redis
+
+from app.config import get_settings
+from app.providers.billing.paddle_billing_provider import PaddleBillingProvider
+from app.services.plans import price_id_for_plan
+
+logger = logging.getLogger("atla.plan_pricing")
+
+_redis = redis.from_url(get_settings().REDIS_URL, decode_responses=True)
+_OK_TTL_SECONDS = 600
+_FAIL_TTL_SECONDS = 30
+CACHE_PREFIX = "plan-price:"
+
+
+def _parse(data) -> dict | None:
+    """Paddle price entity -> {amount_minor, currency, interval, interval_count}. None if not a usable recurring price."""
+    if not isinstance(data, dict) or data.get("status") != "active":
+        return None
+    unit = data.get("unit_price") or {}
+    amount, currency = unit.get("amount"), unit.get("currency_code")
+    if not (isinstance(amount, (str, int)) and str(amount).isdigit() and currency):
+        return None
+    cycle = data.get("billing_cycle") or {}
+    if not cycle.get("interval"):
+        return None  # we only sell subscriptions
+    return {
+        "amount_minor": int(amount),
+        "currency": currency,
+        "interval": cycle["interval"],
+        "interval_count": int(cycle.get("frequency") or 1),
+    }
+
+
+def price_for_plan(plan_id: str) -> dict | None:
+    price_id = price_id_for_plan(plan_id)
+    if not price_id:
+        return None
+    key = f"{CACHE_PREFIX}{price_id}"
+    try:
+        cached = _redis.get(key)
+    except redis.RedisError:
+        cached = None
+    if cached is not None:
+        return json.loads(cached)
+
+    parsed, ttl = None, _FAIL_TTL_SECONDS
+    try:
+        parsed = _parse(PaddleBillingProvider().get_price(price_id))
+        if parsed is not None:
+            ttl = _OK_TTL_SECONDS
+    except RuntimeError as e:  # includes PaddleAPIError and "not configured"
+        logger.warning("Could not read price for plan %s from Paddle: %s", plan_id, e)
+    try:
+        _redis.set(key, json.dumps(parsed), ex=ttl)
+    except redis.RedisError:
+        pass
+    return parsed
diff --git a/backend/app/services/plans.py b/backend/app/services/plans.py
new file mode 100644
index 0000000..7342e75
--- /dev/null
+++ b/backend/app/services/plans.py
@@ -0,0 +1,146 @@
+"""
+The ONE authoritative definition of plans and what each plan includes.
+
+* Plan <-> Paddle price mapping comes from config (PADDLE_*_PRICE_ID); a Paddle
+  subscription's plan is always derived from its actual PRICE, never from
+  client-influenced data.
+* Features: Growth = Starter + GROWTH_ONLY. Inheritance is by construction, so
+  Starter can never hold something Growth lacks.
+* Every server-side feature gate goes through `require_feature` (auth/deps.py),
+  which calls into here. Do not compare plan names anywhere else.
+
+Growth-only features are each backed by a real, tested endpoint behind
+require_feature: full transcripts, transcript search, analytics. Do not list a feature here
+unless its route is gated by it.
+
+Included minutes come from settings (STARTER/GROWTH_INCLUDED_MINUTES), derived by
+`python -m app.workers.pricing_report`. The displayed PRICE is never stored here: it is read
+from the Paddle price behind each plan (services/plan_pricing.py), so it cannot drift from billing.
+"""
+import logging
+import uuid
+from dataclasses import dataclass
+from enum import Enum
+
+from sqlalchemy.orm import Session
+
+from app.config import get_settings
+from app.services.billing_state import ACTIVE_STATUSES, current_subscription
+
+logger = logging.getLogger("atla.plans")
+
+UNKNOWN_PLAN = "unknown"
+
+
+class Feature(str, Enum):
+    phone_number = "phone_number"  # buy / keep a real business number (costs us money)
+    go_live = "go_live"  # route real calls to the receptionist (costs us money)
+    transcripts = "transcripts"  # read the full conversation, not just the summary (Growth)
+    transcript_search = "transcript_search"  # search what callers said across all calls (Growth)
+    analytics = "analytics"  # call / lead / usage trends over time (Growth)
+
+
+FEATURE_LABELS: dict[Feature, str] = {
+    Feature.phone_number: "A dedicated business phone number",
+    Feature.go_live: "Your receptionist answers real calls",
+    Feature.transcripts: "Full conversation transcripts, with who said what and when",
+    Feature.transcript_search: "Search everything your callers said",
+    Feature.analytics: "Call, lead and usage analytics over time",
+}
+
+STARTER_FEATURES: frozenset[Feature] = frozenset({Feature.phone_number, Feature.go_live})
+GROWTH_ONLY_FEATURES: frozenset[Feature] = frozenset(
+    {Feature.transcripts, Feature.transcript_search, Feature.analytics}
+)
+
+# True for every plan today and not gated (they do not cost us more per customer): shown on both cards.
+BASELINE_INCLUDED: tuple[str, ...] = (
+    "Call history with an AI summary of every call",
+    "Lead capture and lead management",
+    "Credits used, credits remaining and calls handled",
+)
+
+def when_credits_run_out() -> str:
+    """Customer-facing policy text, built from the real settings so it can never disagree with them."""
+    s = get_settings()
+    return (
+        f"When your included minutes run out, you can buy more any time (from ${s.TOPUP_MIN_CENTS / 100:,.0f}). "
+        "Your receptionist keeps answering for a short grace period, then pauses until you add credits."
+    )
+
+
+@dataclass(frozen=True)
+class Plan:
+    id: str
+    name: str  # customer-facing
+    rank: int
+    features: frozenset[Feature]
+    included_minutes: int = 0  # monthly allowance (settings); never rolls over
+
+
+_settings = get_settings()
+
+PLANS: dict[str, Plan] = {
+    "starter": Plan("starter", "Starter", 1, STARTER_FEATURES, _settings.STARTER_INCLUDED_MINUTES),
+    "growth": Plan("growth", "Growth", 2, STARTER_FEATURES | GROWTH_ONLY_FEATURES, _settings.GROWTH_INCLUDED_MINUTES),
+}
+
+_PRICE_SETTING = {"starter": "PADDLE_STARTER_PRICE_ID", "growth": "PADDLE_GROWTH_PRICE_ID"}
+
+
+def price_id_for_plan(plan_id: str) -> str:
+    name = _PRICE_SETTING.get(plan_id)
+    return (getattr(get_settings(), name, "") or "") if name else ""
+
+
+def plan_id_for_price(price_id: str | None) -> str | None:
+    if not price_id:
+        return None
+    for plan_id in _PRICE_SETTING:
+        configured = price_id_for_plan(plan_id)
+        if configured and configured == price_id:
+            return plan_id
+    return None
+
+
+def plan_id_from_items(items) -> str | None:
+    """
+    Plan implied by a Paddle subscription's items.
+      None        -> payload carried no price information at all
+      "unknown"   -> prices present but not (only) ours: fail closed, no features
+      "starter"/"growth" -> every price maps to that one plan
+    """
+    if not isinstance(items, list) or not items:
+        return None
+    resolved: set[str] = set()
+    for item in items:
+        price = item.get("price") if isinstance(item, dict) else None
+        price_id = price.get("id") if isinstance(price, dict) else None
+        if price_id:
+            resolved.add(plan_id_for_price(price_id) or UNKNOWN_PLAN)
+    if not resolved:
+        return None
+    return next(iter(resolved)) if len(resolved) == 1 else UNKNOWN_PLAN
+
+
+def active_plan(db: Session, organization_id: uuid.UUID) -> Plan | None:
+    """The plan the org is entitled to RIGHT NOW (trialing/active only). Unknown plan ids get nothing."""
+    sub = current_subscription(db, organization_id)
+    if sub is None or sub.status not in ACTIVE_STATUSES:
+        return None
+    plan = PLANS.get(sub.plan_id)
+    if plan is None:
+        logger.error("Active subscription %s has unrecognised plan_id %r — granting no features", sub.id, sub.plan_id)
+    return plan
+
+
+def plan_allows(db: Session, organization_id: uuid.UUID, feature: Feature) -> bool:
+    plan = active_plan(db, organization_id)
+    return plan is not None and feature in plan.features
+
+
+def lowest_plan_with(feature: Feature) -> Plan | None:
+    for plan in sorted(PLANS.values(), key=lambda p: p.rank):
+        if feature in plan.features:
+            return plan
+    return None
diff --git a/backend/app/services/pricing.py b/backend/app/services/pricing.py
new file mode 100644
index 0000000..3b54ac1
--- /dev/null
+++ b/backend/app/services/pricing.py
@@ -0,0 +1,58 @@
+"""
+Unit economics: how many included minutes a plan price can afford, and what a top-up minute must cost.
+
+Pure arithmetic over INTERNAL inputs (config.py). Nothing here is ever sent to a customer.
+
+    revenue            = the Paddle price
+    variable cost      = minutes x COST_BASIS_CENTS_PER_MINUTE
+                         + PHONE_NUMBER_CENTS_PER_MONTH            (one number per customer)
+                         + Paddle fee (PADDLE_FEE_PERCENT of the price + PADDLE_FEE_FIXED_CENTS)
+    gross margin       = (revenue - variable cost) / revenue
+
+Provider cost unit: Retell documents call_cost.combined_cost "in cents" (API reference, Get Call).
+Retell's published rates as read on 2026-10-11: voice infrastructure $0.055/min, telephony $0.015/min,
+phone number $2.00/month, plus the LLM you select (billed per minute). The cost basis must cover
+infrastructure + telephony + YOUR LLM; the measured average from real calls is printed by
+`python -m app.workers.pricing_report` so the basis can be checked against reality.
+"""
+from dataclasses import dataclass
+
+from app.config import Settings
+
+
+@dataclass(frozen=True)
+class Economics:
+    revenue_minor: int
+    minutes: int
+    provider_cost_minor: int
+    phone_cost_minor: int
+    paddle_fee_minor: int
+    gross_margin_percent: float
+
+
+def paddle_fee_minor(settings: Settings, revenue_minor: int) -> int:
+    return -(-revenue_minor * settings.PADDLE_FEE_PERCENT // 100) + settings.PADDLE_FEE_FIXED_CENTS  # ceil(percent) + fixed
+
+
+def plan_economics(settings: Settings, price_minor: int, included_minutes: int) -> Economics:
+    provider = included_minutes * settings.COST_BASIS_CENTS_PER_MINUTE
+    phone = settings.PHONE_NUMBER_CENTS_PER_MONTH
+    fee = paddle_fee_minor(settings, price_minor)
+    margin = (price_minor - provider - phone - fee) / price_minor * 100 if price_minor else 0.0
+    return Economics(price_minor, included_minutes, provider, phone, fee, round(margin, 2))
+
+
+def max_included_minutes(settings: Settings, price_minor: int) -> int:
+    """The most minutes this price can include while still earning TARGET_GROSS_MARGIN_PERCENT."""
+    budget = price_minor * (100 - settings.TARGET_GROSS_MARGIN_PERCENT) / 100
+    budget -= paddle_fee_minor(settings, price_minor) + settings.PHONE_NUMBER_CENTS_PER_MONTH
+    return max(0, int(budget // settings.COST_BASIS_CENTS_PER_MINUTE))
+
+
+def topup_economics(settings: Settings, amount_minor: int) -> Economics:
+    """A top-up has no phone number cost: just the minutes it buys and Paddle's fee."""
+    minutes = amount_minor // settings.TOPUP_CENTS_PER_MINUTE
+    provider = minutes * settings.COST_BASIS_CENTS_PER_MINUTE
+    fee = paddle_fee_minor(settings, amount_minor)
+    margin = (amount_minor - provider - fee) / amount_minor * 100 if amount_minor else 0.0
+    return Economics(amount_minor, minutes, provider, 0, fee, round(margin, 2))
diff --git a/backend/app/services/subscription_sync.py b/backend/app/services/subscription_sync.py
new file mode 100644
index 0000000..583d141
--- /dev/null
+++ b/backend/app/services/subscription_sync.py
@@ -0,0 +1,111 @@
+"""
+Applies one Paddle subscription snapshot to our `subscriptions` row. Shared by
+the webhook (event data + event.occurred_at) and the reconciliation job (GET
+/subscriptions/{id} data + its updated_at), so both obey the same rules:
+
+* one local row per Paddle subscription id
+* a snapshot older than the newest one already applied is ignored (webhooks are
+  at-least-once and unordered; an old `active` can never resurrect a `canceled`)
+* the PLAN comes from the subscription's actual price ids (services/plans.py);
+  custom_data.plan_id is only a fallback for payloads that carry no items
+"""
+import logging
+import uuid
+from datetime import datetime
+
+from sqlalchemy.orm import Session
+
+from app.db.models.billing import Subscription
+from app.db.models.tenancy import Organization
+from app.services.credits import ensure_plan_grant
+from app.services.plans import UNKNOWN_PLAN, plan_id_from_items
+
+logger = logging.getLogger("atla.subscription_sync")
+
+
+def parse_uuid(value) -> uuid.UUID | None:
+    try:
+        return uuid.UUID(str(value))
+    except (ValueError, TypeError):
+        return None
+
+
+def parse_dt(value) -> datetime | None:
+    if not value:
+        return None
+    try:
+        return datetime.fromisoformat(str(value).replace("Z", "+00:00"))
+    except ValueError:
+        return None
+
+
+def resolve_plan_id(data: dict, existing: str | None) -> str:
+    from_items = plan_id_from_items(data.get("items"))
+    if from_items is not None:
+        if from_items == UNKNOWN_PLAN:
+            logger.error("Paddle subscription %s has a price that maps to no configured plan", data.get("id"))
+        return from_items
+    custom = data.get("custom_data") or {}
+    return custom.get("plan_id") or existing or UNKNOWN_PLAN
+
+
+def sync_subscription(db: Session, data: dict, occurred_at: datetime) -> bool:
+    """Returns True if the snapshot was applied, False if ignored."""
+    external_id = data.get("id")
+    new_status = data.get("status")
+    custom = data.get("custom_data") or {}
+    if not external_id or not new_status:
+        logger.error("Paddle subscription snapshot missing id/status")
+        return False
+
+    subscription = (
+        db.query(Subscription)
+        .filter(Subscription.billing_provider == "paddle", Subscription.external_subscription_id == external_id)
+        .with_for_update()
+        .first()
+    )
+    if subscription is None:
+        org_id = parse_uuid(custom.get("organization_id"))
+        if org_id is None or db.get(Organization, org_id) is None:
+            logger.error("Paddle subscription %s has no valid organization_id in custom_data", external_id)
+            return False
+        subscription = Subscription(
+            organization_id=org_id,
+            billing_provider="paddle",
+            external_subscription_id=external_id,
+            plan_id=resolve_plan_id(data, None),
+            status=new_status,
+            status_changed_at=occurred_at,
+        )
+        db.add(subscription)
+    else:
+        if subscription.last_event_at is not None and occurred_at < subscription.last_event_at:
+            logger.warning("Ignoring stale Paddle snapshot for %s (%s < %s)", external_id, occurred_at, subscription.last_event_at)
+            return False
+        if (
+            subscription.status == "canceled"
+            and new_status != "canceled"
+            and subscription.last_event_at is not None
+            and occurred_at <= subscription.last_event_at
+        ):
+            logger.warning("Ignoring non-canceled snapshot for already-canceled subscription %s", external_id)
+            return False
+        if subscription.status != new_status:
+            subscription.status_changed_at = occurred_at
+        subscription.status = new_status
+        subscription.plan_id = resolve_plan_id(data, subscription.plan_id)
+
+    subscription.last_event_at = occurred_at
+    scheduled = data.get("scheduled_change") if isinstance(data.get("scheduled_change"), dict) else None
+    subscription.cancel_effective_at = (
+        parse_dt(scheduled.get("effective_at")) if scheduled and scheduled.get("action") == "cancel" else None
+    )
+    period = data.get("current_billing_period") or {}
+    subscription.current_period_start = parse_dt(period.get("starts_at")) or subscription.current_period_start
+    subscription.current_period_end = parse_dt(period.get("ends_at")) or subscription.current_period_end
+
+    # Monthly included credits: one grant per billing period, created here for every path that
+    # applies a snapshot (webhook AND reconciler), idempotent by (subscription, period start).
+    db.flush()
+    ensure_plan_grant(db, subscription)
+    return True
diff --git a/backend/app/services/topups.py b/backend/app/services/topups.py
new file mode 100644
index 0000000..546f091
--- /dev/null
+++ b/backend/app/services/topups.py
@@ -0,0 +1,281 @@
+"""
+Customer-chosen credit top-ups (minimum $20) paid through a one-time Paddle transaction.
+
+Safety rules, in order of importance:
+  1. Credits are granted ONLY when Paddle says the transaction is completed — from the signed webhook,
+     or by the reconciler reading the transaction back from Paddle. A browser redirect grants nothing.
+  2. A grant is idempotent: ledger key `topup:<transaction id>` is unique, and the purchase row is locked
+     and status-checked, so duplicate / retried / concurrent deliveries credit once.
+  3. The amount credited comes from OUR row (written server-side before the transaction existed), and the
+     transaction's own line items must match it exactly; otherwise nothing is granted and it is logged.
+  4. Failed, canceled, abandoned and still-unpaid checkouts grant zero.
+  5. Refunds and chargebacks claw credits back through the same ledger (see apply_adjustment).
+
+Refund / chargeback policy (customer-facing and auditable):
+  * An APPROVED refund removes the same share of the top-up's credits as the share of the price refunded.
+  * An APPROVED chargeback removes all of that top-up's remaining credits; if the chargeback is later
+    reversed in the customer's favour for us, they are restored.
+  * Clawed-back credits may already have been spent: the purchased balance then goes negative, which blocks
+    new calls (and, past the grace limit, pauses the receptionist) until the customer buys more.
+  * Subscription refunds do NOT change credits; they are handled by cancelling the subscription.
+"""
+import logging
+import uuid
+from datetime import datetime, timedelta, timezone
+
+from sqlalchemy.orm import Session
+
+from app.config import get_settings
+from app.db.models.billing import TopupPurchase
+from app.providers.billing.paddle_billing_provider import PaddleBillingProvider
+from app.services.credits import add_ledger_entry, lock_org_credits
+
+logger = logging.getLogger("atla.topups")
+
+CURRENCY = "USD"
+GRANTED_STATES = ("completed", "partially_refunded", "refunded", "chargeback")
+
+
+class InvalidTopup(ValueError):
+    """The requested amount isn't allowed. The message is written for the customer."""
+
+
+def credit_seconds_for(amount_minor: int) -> int:
+    return amount_minor * 60 // get_settings().TOPUP_CENTS_PER_MINUTE
+
+
+def validate_amount(amount_minor) -> int:
+    s = get_settings()
+    if isinstance(amount_minor, bool) or not isinstance(amount_minor, int):
+        raise InvalidTopup("Enter a whole number of cents.")
+    if amount_minor < s.TOPUP_MIN_CENTS:
+        raise InvalidTopup(f"The minimum top-up is ${s.TOPUP_MIN_CENTS / 100:,.0f}.")
+    if amount_minor > s.TOPUP_MAX_CENTS:
+        raise InvalidTopup(f"The maximum top-up is ${s.TOPUP_MAX_CENTS / 100:,.0f}. Contact us for larger amounts.")
+    return amount_minor
+
+
+def quote(amount_minor) -> dict:
+    amount = validate_amount(amount_minor)
+    seconds = credit_seconds_for(amount)
+    return {
+        "amount_minor": amount,
+        "currency": CURRENCY,
+        "credit_seconds": seconds,
+        "credit_minutes": seconds // 60,
+        "cents_per_minute": get_settings().TOPUP_CENTS_PER_MINUTE,
+    }
+
+
+def create_topup(db: Session, organization_id: uuid.UUID, user_id: uuid.UUID, amount_minor: int, provider=None) -> TopupPurchase:
+    """Writes the purchase row FIRST, then asks Paddle for the one-time transaction. Raises RuntimeError on provider failure."""
+    q = quote(amount_minor)
+    row = TopupPurchase(
+        organization_id=organization_id,
+        user_id=user_id,
+        amount_minor=q["amount_minor"],
+        currency=CURRENCY,
+        credit_seconds=q["credit_seconds"],
+        cents_per_minute=q["cents_per_minute"],
+        status="created",
+    )
+    db.add(row)
+    db.commit()
+    try:
+        provider = provider or PaddleBillingProvider()
+        session = provider.create_topup_transaction(
+            organization_id=str(organization_id),
+            topup_id=str(row.id),
+            amount_minor=row.amount_minor,
+            currency=CURRENCY,
+            description=f"Atla call credits: {q['credit_minutes']} minutes",
+            display_name=f"Call credits ({q['credit_minutes']} min)",
+        )
+    except RuntimeError:
+        row.status = "failed"  # nothing exists at Paddle, nothing can be paid
+        db.commit()
+        raise
+    row.provider_transaction_id = session.provider_session_id
+    row.checkout_url = session.checkout_url
+    db.commit()
+    return row
+
+
+def _find(db: Session, data: dict) -> TopupPurchase | None:
+    txn_id = data.get("id") or data.get("transaction_id")
+    row = None
+    if txn_id:
+        row = db.query(TopupPurchase).filter(TopupPurchase.provider_transaction_id == txn_id).with_for_update().first()
+    if row is None:
+        topup_id = (data.get("custom_data") or {}).get("topup_id")
+        try:
+            tid = uuid.UUID(str(topup_id)) if topup_id else None
+        except ValueError:
+            tid = None
+        if tid is not None:
+            row = db.query(TopupPurchase).filter(TopupPurchase.id == tid).with_for_update().first()
+    return row
+
+
+def is_topup_transaction(data: dict) -> bool:
+    return (data.get("custom_data") or {}).get("kind") == "topup"
+
+
+def _items_total_minor(data: dict) -> int | None:
+    items = data.get("items")
+    if not isinstance(items, list) or not items:
+        return None
+    total = 0
+    for it in items:
+        price = it.get("price") if isinstance(it, dict) else None
+        unit = (price or {}).get("unit_price") or {}
+        try:
+            total += int(unit["amount"]) * int(it.get("quantity", 1))
+        except (KeyError, TypeError, ValueError):
+            return None
+        if unit.get("currency_code") not in (None, CURRENCY):
+            return None
+    return total
+
+
+def _grant(db: Session, row: TopupPurchase, txn_id: str) -> bool:
+    lock_org_credits(db, row.organization_id)
+    granted = add_ledger_entry(
+        db,
+        organization_id=row.organization_id,
+        kind="topup",
+        seconds=row.credit_seconds,
+        idempotency_key=f"topup:{txn_id}",
+        reference=txn_id,
+        note=f"Top-up ${row.amount_minor / 100:,.2f}",
+    )
+    row.status = "completed"
+    row.completed_at = row.completed_at or datetime.now(timezone.utc)
+    row.provider_transaction_id = row.provider_transaction_id or txn_id
+    return granted
+
+
+def complete_topup(db: Session, data: dict) -> bool:
+    """Called with a Paddle transaction (webhook or reconciler read-back) whose status is `completed`.
+    Returns True only if THIS call granted credits."""
+    if data.get("status") != "completed":
+        return False
+    row = _find(db, data)
+    if row is None:
+        logger.error("Completed top-up transaction %s matches no purchase row — NOT granting; investigate", data.get("id"))
+        return False
+    if row.status in GRANTED_STATES:
+        return False  # already credited (duplicate / retried delivery)
+    org = (data.get("custom_data") or {}).get("organization_id")
+    if org and str(row.organization_id) != str(org):
+        logger.error("Top-up %s org mismatch (row=%s paddle=%s) — NOT granting", row.id, row.organization_id, org)
+        return False
+    paid = _items_total_minor(data)
+    if paid != row.amount_minor:
+        logger.error("Top-up %s amount mismatch (row=%s paddle=%s) — NOT granting", row.id, row.amount_minor, paid)
+        return False
+    return _grant(db, row, str(data["id"]))
+
+
+def fail_topup(db: Session, data: dict) -> bool:
+    """canceled / payment_failed / past_due: nothing was paid, nothing is granted. Can still complete later if it is paid."""
+    row = _find(db, data)
+    if row is None or row.status != "created":
+        return False
+    row.status = "failed"
+    return True
+
+
+def apply_adjustment(db: Session, adj: dict) -> bool:
+    """Paddle adjustment (refund / chargeback) for a top-up transaction. Idempotent per adjustment id."""
+    if adj.get("status") != "approved":
+        return False  # pending / rejected / reversed: no money has moved
+    action = adj.get("action")
+    if action not in ("refund", "chargeback", "chargeback_reverse"):
+        return False
+    row = _find(db, {"id": adj.get("transaction_id")})
+    if row is None:
+        return False  # not a top-up (e.g. a subscription transaction): credits unaffected by policy
+    adj_id = str(adj.get("id"))
+    txn_id = row.provider_transaction_id or str(adj.get("transaction_id"))
+    if row.status == "created":
+        # An approved adjustment proves the transaction was paid; credit it first so the ledger tells the whole story.
+        _grant(db, row, txn_id)
+    lock_org_credits(db, row.organization_id)
+
+    if action == "refund":
+        try:
+            refunded = int(((adj.get("totals") or {}).get("subtotal")))
+        except (TypeError, ValueError):
+            logger.error("Refund %s has no usable subtotal — flagged for manual review", adj_id)
+            return False
+        row.refunded_minor = min(row.amount_minor, row.refunded_minor + refunded)
+        target = row.credit_seconds * row.refunded_minor // row.amount_minor
+        delta = target - row.clawed_back_seconds
+        applied = delta > 0 and add_ledger_entry(
+            db, organization_id=row.organization_id, kind="refund", seconds=-delta,
+            idempotency_key=f"refund:{adj_id}", reference=adj_id, note=f"Refund ${refunded / 100:,.2f}",
+        )
+        if applied:
+            row.clawed_back_seconds += delta
+            row.status = "refunded" if row.refunded_minor >= row.amount_minor else "partially_refunded"
+        return bool(applied)
+
+    if action == "chargeback":
+        remaining = row.credit_seconds - row.clawed_back_seconds
+        applied = remaining > 0 and add_ledger_entry(
+            db, organization_id=row.organization_id, kind="chargeback", seconds=-remaining,
+            idempotency_key=f"chargeback:{adj_id}", reference=adj_id, note="Chargeback",
+        )
+        if applied:
+            row.clawed_back_seconds += remaining
+            row.status = "chargeback"
+        return bool(applied)
+
+    # chargeback_reverse: the dispute was decided in our favour — give the credits back.
+    restored = add_ledger_entry(
+        db, organization_id=row.organization_id, kind="adjustment", seconds=row.clawed_back_seconds,
+        idempotency_key=f"chargeback_reverse:{adj_id}", reference=adj_id, note="Chargeback reversed",
+    ) if row.status == "chargeback" and row.clawed_back_seconds > 0 else False
+    if restored:
+        row.clawed_back_seconds = 0
+        row.status = "completed"
+    return bool(restored)
+
+
+def reconcile_topups(db: Session, provider=None, now: datetime | None = None) -> dict:
+    """
+    Settles top-ups whose webhook never arrived (or arrived out of order) by reading the transaction back
+    from Paddle. completed -> credits (idempotent); canceled / past_due / payment failed -> failed, zero credits;
+    still draft/ready/billed -> left alone (the customer may yet pay). Rows that never got a transaction
+    (a crash between our insert and Paddle's reply) are failed after 30 minutes: nothing can have been paid.
+    """
+    now = now or datetime.now(timezone.utc)
+    result = {"granted": 0, "failed": 0, "still_open": 0, "errors": 0}
+    stale = now - timedelta(minutes=10)
+    rows = db.query(TopupPurchase).filter(TopupPurchase.status == "created", TopupPurchase.created_at < stale).all()
+    for row in rows:
+        if not row.provider_transaction_id:
+            if row.created_at < now - timedelta(minutes=30):
+                row.status = "failed"
+                result["failed"] += 1
+            continue
+        try:
+            provider = provider or PaddleBillingProvider()
+            txn = provider.get_transaction(row.provider_transaction_id)
+        except RuntimeError:
+            result["errors"] += 1
+            continue
+        if txn is None:
+            continue
+        status = txn.get("status")
+        if status == "completed":
+            if complete_topup(db, txn):
+                result["granted"] += 1
+        elif status in ("canceled", "past_due"):
+            row.status = "failed"
+            result["failed"] += 1
+        else:
+            result["still_open"] += 1
+    db.commit()
+    return result
