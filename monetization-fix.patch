+"use client";
+
+import { useEffect, useState } from "react";
+import { api } from "./api";
+
+/** Which paid features the server says this organization has right now. `null` while loading or unreadable. */
+export function useFeatures(orgId: string | undefined): { features: Set<string> | null; plan: string | null } {
+  const [data, setData] = useState<{ features: Set<string>; plan: string | null } | null>(null);
+  useEffect(() => {
+    if (!orgId) return;
+    let live = true;
+    api
+      .getSubscription(orgId)
+      .then((sub) => {
+        if (live) setData({ features: new Set(sub?.entitled ? sub.features.map((f) => f.id) : []), plan: sub?.plan_name ?? null });
+      })
+      .catch(() => undefined);
+    return () => {
+      live = false;
+    };
+  }, [orgId]);
+  return { features: data?.features ?? null, plan: data?.plan ?? null };
+}
diff --git a/frontend/src/lib/usePlans.ts b/frontend/src/lib/usePlans.ts
new file mode 100644
index 0000000..195171e
--- /dev/null
+++ b/frontend/src/lib/usePlans.ts
@@ -0,0 +1,37 @@
+"use client";
+
+import { useCallback, useEffect, useState } from "react";
+import { api, PlanOut } from "./api";
+
+/** The plan catalog (names, what's included, Paddle-backed prices) from the backend. */
+export function usePlans() {
+  const [plans, setPlans] = useState<PlanOut[] | null>(null);
+  const [failed, setFailed] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+
+  useEffect(() => {
+    let live = true;
+    api
+      .listPlans()
+      .then((p) => {
+        if (live) {
+          setPlans(p);
+          setFailed(false);
+        }
+      })
+      .catch(() => {
+        if (live) setFailed(true);
+      });
+    return () => {
+      live = false;
+    };
+  }, [attempt]);
+
+  const reload = useCallback(() => {
+    setFailed(false);
+    setPlans(null);
+    setAttempt((n) => n + 1);
+  }, []);
+
+  return { plans, loading: plans === null && !failed, failed, reload };
+}
diff --git a/frontend/src/lib/useShellStatus.ts b/frontend/src/lib/useShellStatus.ts
new file mode 100644
index 0000000..39c4ddd
--- /dev/null
+++ b/frontend/src/lib/useShellStatus.ts
@@ -0,0 +1,81 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { api, AgentOut, PhoneNumberOut, SubscriptionOut } from "./api";
+import { describeSubscription } from "./billingState";
+import { receptionistStatus, type ReceptionistStatus, type StatusTone } from "./receptionistStatus";
+
+interface ShellData {
+  agent: AgentOut | null;
+  agentKnown: boolean;
+  phone: PhoneNumberOut | null;
+  sub: SubscriptionOut | null | undefined; // undefined = couldn't be read
+}
+
+export interface PlanChip {
+  name: string;
+  state: string;
+  tone: StatusTone;
+}
+
+const FRESH_MS = 10_000;
+const cache = new Map<string, { at: number; data: ShellData }>();
+const inflight = new Map<string, Promise<ShellData>>();
+
+/** Call on sign-out so the next account never sees the previous one's status. */
+export function clearShellStatus() {
+  cache.clear();
+  inflight.clear();
+}
+
+function fetchShell(orgId: string): Promise<ShellData> {
+  const running = inflight.get(orgId);
+  if (running) return running;
+  const promise = Promise.allSettled([api.listAgents(orgId), api.listPhoneNumbers(orgId), api.getSubscription(orgId)])
+    .then(([agents, phones, sub]) => {
+      const data: ShellData = {
+        agentKnown: agents.status === "fulfilled",
+        agent: agents.status === "fulfilled" ? (agents.value[0] ?? null) : null,
+        phone: phones.status === "fulfilled" ? (phones.value.find((n) => n.status === "active") ?? null) : null,
+        sub: sub.status === "fulfilled" ? sub.value : undefined,
+      };
+      cache.set(orgId, { at: Date.now(), data });
+      return data;
+    })
+    .finally(() => inflight.delete(orgId));
+  inflight.set(orgId, promise);
+  return promise;
+}
+
+/**
+ * Receptionist + plan status for the app shell. Served instantly from a short
+ * cache while a fresh copy loads in the background, so moving between pages
+ * doesn't flash a skeleton or hammer the API.
+ */
+export function useShellStatus(orgId: string | undefined) {
+  const [data, setData] = useState<ShellData | null>(() => (orgId ? (cache.get(orgId)?.data ?? null) : null));
+
+  useEffect(() => {
+    if (!orgId) return;
+    const cached = cache.get(orgId);
+    if (cached && Date.now() - cached.at < FRESH_MS) return;
+    let live = true;
+    fetchShell(orgId).then((d) => {
+      if (live) setData(d);
+    });
+    return () => {
+      live = false;
+    };
+  }, [orgId]);
+
+  if (!data) return { loading: true, status: null as ReceptionistStatus | null, plan: null as PlanChip | null, canTest: false };
+
+  const status = data.agentKnown ? receptionistStatus({ agent: data.agent, phone: data.phone, sub: data.sub }) : null;
+  let plan: PlanChip | null = null;
+  if (data.sub === null) plan = { name: "No plan", state: "Choose a plan", tone: "neutral" };
+  else if (data.sub) {
+    const info = describeSubscription(data.sub);
+    plan = { name: data.sub.plan_name ?? "Your plan", state: info.label, tone: info.tone };
+  }
+  return { loading: false, status, plan, canTest: data.agentKnown && data.agent !== null };
+}
diff --git a/frontend/tests/logic.test.ts b/frontend/tests/logic.test.ts
new file mode 100644
index 0000000..31a156c
--- /dev/null
+++ b/frontend/tests/logic.test.ts
@@ -0,0 +1,41 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { validateTopup, quickAmounts, creditView, creditBanner, chartBars } from "../src/lib/credits.ts";
+import { planHighlights } from "../src/lib/planCompare.ts";
+
+const base: any = { entitled: true, plan_name: "Starter", period_start: "x", period_end: "y", included_granted_seconds: 10800, included_used_seconds: 0, included_remaining_seconds: 10800, purchased_balance_seconds: 0, available_seconds: 10800, status: "ok", calls_handled: 0, topup_min_minor: 2000, topup_max_minor: 50000, topup_cents_per_minute: 45, free_test_calls_remaining: 0, when_credits_run_out: "" };
+
+test("top-up minimum $20 and formats", () => {
+  assert.equal(validateTopup("19.99", 2000, 50000).ok, false);
+  assert.deepEqual(validateTopup("20", 2000, 50000), { ok: true, amountMinor: 2000 });
+  assert.deepEqual(validateTopup("$1,250.00", 2000, 500000), { ok: true, amountMinor: 125000 });
+  assert.equal(validateTopup("abc", 2000, 50000).ok, false);
+  assert.equal(validateTopup("", 2000, 50000).ok, false);
+  assert.equal(validateTopup("500.01", 2000, 50000).ok, false);
+});
+test("quick amounts derive from server minimum", () => {
+  assert.deepEqual(quickAmounts(2000, 50000), [2000, 4000, 10000]);
+  assert.deepEqual(quickAmounts(2000, 5000), [2000, 4000]);
+});
+test("credit states", () => {
+  assert.equal(creditBanner(base), null);
+  assert.equal(creditBanner({ ...base, status: "low" })?.tone, "low");
+  assert.equal(creditBanner({ ...base, status: "empty", available_seconds: 0 })?.tone, "empty");
+  assert.equal(creditBanner({ ...base, entitled: false, status: "empty" }), null);
+  assert.equal(creditView({ ...base, entitled: false, included_granted_seconds: 0 }).kind, "unmetered");
+  const v: any = creditView({ ...base, purchased_balance_seconds: -120 });
+  assert.equal(v.owes, "2 min");
+});
+test("chart bars scale to real max, zeros are empty", () => {
+  const pts = [{ date: "2026-10-01", calls: 0, credit_seconds: 0 }, { date: "2026-10-02", calls: 4, credit_seconds: 0 }, { date: "2026-10-03", calls: 2, credit_seconds: 0 }];
+  const r = chartBars(pts, (p) => p.calls);
+  assert.deepEqual(r.bars.map((b) => b.height), [0, 1, 0.5]);
+  assert.equal(chartBars(pts, (p) => p.credit_seconds).empty, true);
+});
+test("plan comparison differentiates Growth from Starter using catalog data", () => {
+  const mk = (id: string, features: string[], mins: number): any => ({ id, name: id, features: features.map((f) => ({ id: f, label: f })), included_minutes: mins, price: { amount_minor: id === "starter" ? 7900 : 19900 } });
+  const h = planHighlights([mk("starter", ["a"], 180), mk("growth", ["a", "transcripts"], 480)] as any);
+  assert.equal(h[1].recommended, true);
+  assert.equal(h[1].extraMinutes, 300);
+  assert.equal(h[1].added.length, 1);
+});
